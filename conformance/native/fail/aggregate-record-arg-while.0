# A record-returning call as an argument is materialized into a temp and hoisted
# in front of its statement — which is only sound where the expression is
# evaluated exactly once. In a loop condition the temp would be built once
# instead of each iteration, so the direct backend rejects it rather than
# miscompile. Hoist it yourself: let p = mk i inside the loop, then useP p.

type P
  a i32
  b i32

fn mk P x i32
  let p P . a x b 2
  ret p

fn useP i32 p P
  ret p.a

pub fn main Void world World !
  mut i i32 0
  while < (useP (mk i)) 3
    set i + i 1
  check world.out.write "unreachable\n"
