pub fun main(world: World) -> Void raises {
    let mut buffer: [4]f32 = [0.0, 0.0, 0.0, 0.0]
    let input: [4]f32 = [3.0, 4.0, 0.0, 0.0]
    let weights: [4]f32 = [1.0, 1.0, 1.0, 1.0]
    let mut ss: f32 = 0.0
    let mut i: usize = 0
    while i < 4 {
        let v: f32 = input[i]
        ss = ss + v * v
        i = i + 1
    }
    let nf: f32 = 4.0
    ss = ss / nf
    let eps: f32 = 0.00001
    ss = ss + eps
    let inv: f32 = 1.0 / std.math.sqrtf(ss)
    let mut j: usize = 0
    while j < 4 {
        buffer[j] = weights[j] * (inv * input[j])
        j = j + 1
    }
    let lo0: f32 = 1.199
    let hi0: f32 = 1.201
    let lo1: f32 = 1.599
    let hi1: f32 = 1.601
    let zeroLo: f32 = 0.0 - 0.001
    let zeroHi: f32 = 0.001
    let ok0: Bool = buffer[0] > lo0 && buffer[0] < hi0
    let ok1: Bool = buffer[1] > lo1 && buffer[1] < hi1
    let ok2: Bool = buffer[2] > zeroLo && buffer[2] < zeroHi
    let ok3: Bool = buffer[3] > zeroLo && buffer[3] < zeroHi
    if ok0 && ok1 && ok2 && ok3 {
        check world.out.write("math rmsnorm ok\n")
    }
}
