// A MutSpan over a mutable fixed array is writable in place: index stores go through the span's
// (ptr, len) pair and reads see the new values. Covers u8 (one byte per element), i32 (4-byte
// element with a negative value), and f32 (read-modify-write through the FP file) — the typed
// element widths a span can hold, exercised without a heap allocation.
pub fun main(world: World) -> Void raises {
    let mut ubuf: [4]u8 = [0, 0, 0, 0]
    let us: MutSpan<u8> = ubuf
    us[0] = 10
    us[3] = 200
    let u0: u8 = us[0]
    let u3: u8 = us[3]
    let ten: u8 = 10
    let twoHundred: u8 = 200
    let okU: Bool = std.mem.len(us) == 4 && u0 == ten && u3 == twoHundred

    let mut ibuf: [4]i32 = [0, 0, 0, 0]
    let is: MutSpan<i32> = ibuf
    is[0] = 100
    is[3] = 0 - 5
    let i0: i32 = is[0]
    let i3: i32 = is[3]
    let hundred: i32 = 100
    let negFive: i32 = 0 - 5
    let okI: Bool = std.mem.len(is) == 4 && i0 == hundred && i3 == negFive

    let mut fbuf: [4]f32 = [0.0, 0.0, 0.0, 0.0]
    let fs: MutSpan<f32> = fbuf
    fs[0] = 1.5
    fs[2] = fs[0] + 2.0
    let f0: f32 = fs[0]
    let f2: f32 = fs[2]
    let onePointFive: f32 = 1.5
    let threePointFive: f32 = 3.5
    let okF: Bool = std.mem.len(fs) == 4 && f0 == onePointFive && f2 == threePointFive

    if okU && okI && okF {
        check world.out.write("mem mut span array store ok\n")
    }
}
