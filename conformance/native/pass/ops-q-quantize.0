// Quantized (int8) activation quantizer — per-group symmetric quantize + round.
//
// Self-contained mirror of `quantizeActs` (and the `roundHA` half-away-from-zero
// rounder) from examples/llama2/src/ops.0, exercised on hand-computed groups.
// Needs libm (floorf via roundHA, fabsf via the per-element magnitude), so it is
// registered with `libm: true` and runs in CI / the Vercel sandbox. A small
// inline dequant checks the round-trip stays within the quantization step.
//
// `quantizeActs` is the byte-for-byte port of `runq.c`'s `quantize`: per group of
// `gs` values, scale = max(|x|) / 127, quant = round(x / scale) with C `round()`
// (half away from zero). No clamp — |x / scale| <= 127 by construction.
//
// Two groups, gs = 4:
//
//   Group 0 — clean scale, away from rounding boundaries:
//     x = [4.0, -3.0, 1.5, 0.5];  wmax = 4.0;  scale = 4/127 ~ 0.031496
//       q[0] = round(4.0   / scale) = round(127.0)  = 127
//       q[1] = round(-3.0  / scale) = round(-95.25) = -95
//       q[2] = round(1.5   / scale) = round(47.625) =  48
//       q[3] = round(0.5   / scale) = round(15.875) =  16
//     dequant(q[i]) = q[i] * scale is within `scale` of x[i] (checked below).
//
//   Group 1 — exact +/-0.5 rounding probe. wmax = 127.0 makes scale = 1.0 exactly,
//   so x / scale = x with no rounding error, pinning the half-away-from-zero rule:
//     x = [2.5, -2.5, 0.5, 127.0]
//       q[0] = round(2.5)   =   3   (2.5 rounds AWAY from zero, not to even 2)
//       q[1] = round(-2.5)  =  -3
//       q[2] = round(0.5)   =   1
//       q[3] = round(127.0) = 127

// Quantized-activation scratch: signed int8 quants kept as i32 plus f32 scales.
shape QActs {
    q: MutSpan<i32>,
    s: MutSpan<f32>,
}

// Round half away from zero, matching C `round()` (std.math has no roundf).
fun roundHA(v: f32) -> i32 {
    let half: f32 = 0.5
    let zero: f32 = 0.0
    if v >= zero {
        let r: f32 = std.math.floorf(v + half)
        return r as i32
    }
    let neg: f32 = zero - v
    let r2: f32 = std.math.floorf(neg + half)
    let ri: i32 = r2 as i32
    return 0 - ri
}

// Port of examples/llama2/src/ops.0 `quantizeActs` (see there for the parity
// notes): per-group symmetric scale max(|x|)/127, quant round(x/scale).
fun quantizeActs(dst: QActs, x: Span<f32>, gs: usize) -> Void {
    let n: usize = std.mem.len(x)
    let dq = dst.q
    let ds = dst.s
    let q_max: f32 = 127.0
    let num_groups: usize = n / gs
    let mut g: usize = 0
    while g < num_groups {
        let gbase: usize = g * gs
        let mut wmax: f32 = 0.0
        let mut i: usize = 0
        while i < gs {
            let v: f32 = std.math.absf(x[gbase + i])
            if v > wmax {
                wmax = v
            }
            i = i + 1
        }
        let scale: f32 = wmax / q_max
        ds[g] = scale
        let mut j: usize = 0
        while j < gs {
            let q: f32 = x[gbase + j] / scale
            dq[gbase + j] = roundHA(q)
            j = j + 1
        }
        g = g + 1
    }
}

pub fun main(world: World) -> Void raises {
    // First the standalone +/-0.5 rounding probe on roundHA, independent of any
    // scale, pinning C round() semantics (ties go away from zero).
    let okRound: Bool =
        roundHA(2.5) == 3 &&
        roundHA(0.0 - 2.5) == (0 - 3) &&
        roundHA(0.5) == 1 &&
        roundHA(0.0 - 0.5) == (0 - 1) &&
        roundHA(1.4) == 1 &&
        roundHA(0.0 - 1.4) == (0 - 1) &&
        roundHA(0.0) == 0

    // Input vector: group 0 then group 1 (gs = 4).
    let xa: [8]f32 = [4.0, 0.0 - 3.0, 1.5, 0.5, 2.5, 0.0 - 2.5, 0.5, 127.0]
    let x: Span<f32> = xa

    // Quant + scale scratch in writable regions (mirrors the run state).
    let alloc = std.mem.pageAlloc()
    let qregion = std.mem.allocBytes(alloc, 64)
    if qregion.has == false {
        return
    }
    let sregion = std.mem.allocBytes(alloc, 64)
    if sregion.has == false {
        return
    }
    let qbase: MutSpan<u8> = qregion.value
    let sbase: MutSpan<u8> = sregion.value
    let qints: MutSpan<i32> = std.mem.bytesAsMutI32(qbase)
    let sflts: MutSpan<f32> = std.mem.bytesAsMutF32(sbase)
    let dq: MutSpan<i32> = qints[0..8]
    let ds: MutSpan<f32> = sflts[0..2]
    let dst = QActs {
        q: dq,
        s: ds
    }

    quantizeActs(dst, x, 4)

    // Scales: group 0 = 4/127 (tight tolerance), group 1 = 1.0 exactly.
    let q_max: f32 = 127.0
    let wantScale0: f32 = 4.0 / q_max
    let s0: f32 = ds[0]
    let s1: f32 = ds[1]
    let dScale0: f32 = s0 - wantScale0
    let okScale0: Bool = dScale0 > (0.0 - 0.00001) && dScale0 < 0.00001
    let okScale1: Bool = s1 == 1.0
    let okScales: Bool = okScale0 && okScale1

    // Quants are exact integers — check against the hand-computed values.
    let okQ0: Bool =
        dq[0] == 127 &&
        dq[1] == (0 - 95) &&
        dq[2] == 48 &&
        dq[3] == 16
    let okQ1: Bool =
        dq[4] == 3 &&
        dq[5] == (0 - 3) &&
        dq[6] == 1 &&
        dq[7] == 127
    let okQuants: Bool = okQ0 && okQ1

    // Dequant round-trip: |dequant(q[i]) - x[i]| <= scale for each value.
    let mut okDeq: Bool = true
    let mut i: usize = 0
    while i < 8 {
        let gi: usize = i / 4
        let scale: f32 = ds[gi]
        let qf: f32 = dq[i] as f32
        let recon: f32 = qf * scale
        let err: f32 = recon - xa[i]
        let within: Bool = err > (0.0 - scale) && err < scale
        if within == false {
            okDeq = false
        }
        i = i + 1
    }

    if okRound && okScales && okQuants && okDeq {
        check world.out.write("ops q quantize ok\n")
    }
    return
}
