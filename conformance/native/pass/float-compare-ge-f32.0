pub fun main(world: World) -> Void raises {
    let small: f32 = 1.0
    let same: f32 = 1.0
    let big: f32 = 2.0
    let greaterThan: Bool = big >= small
    let equal: Bool = small >= same
    let less: Bool = small >= big
    if greaterThan && equal && less == false {
        check world.out.write("float ge f32 ok\n")
    }
}
