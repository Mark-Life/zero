// llama2 Phase 5 + enhancement F: self-contained BPE tokenizer with sorted-index lookup.
//
// Self-contained mirror of examples/llama2/src/tokenizer.0 over a synthetic 8-token
// vocab held as a u8 array literal (no fs, so it runs in CI). The vocab is the
// Karpathy tokenizer.bin layout — [max_token_length:i32] then per token
// [score:f32][len:i32][bytes] — for:
//   0:"<unk>"(0)  1:"<s>"(0)  2:"</s>"(0)  3:" "(-3)
//   4:"a"(-4)     5:"b"(-5)   6:"ab"(-1)   7:" a"(-2)
//
// Enhancement F replaces the v0.1 linear scans with two load-time indices built into
// ONE combined i32 region (here a [16]i32 stack array = 2*vocab), sliced into an
// entry-offset table (first half) and a string-sorted id list (second half):
//   - sortIdByStr: ascending heapsort of the ids by their token string (the
//     sortDescByProb skeleton from sampler.0, max-heap, single array, no break),
//   - findStr / findStrConcat: binary search over the sorted index (the latter
//     compares the virtual a++b without materializing it).
// One combined region keeps the record-returning buildTokenizer call within the
// direct backend's five-integer-argument cap (the sret pointer takes one register).
//
// Checks: the sorted id order (3,7,2,1,0,4,6,5 — ascending by byte string), the
// dummy-space prefix, single-char lookup, score-driven merge selection (pair
// "a"+"b"=>"ab" score -1 beats " "+"a"=>" a" score -2), BOS prepend, and decode
// with the post-BOS leading-space strip. Token ids are identical to the v0.1 path.

shape Tok {
    bytes: Span<u8>,
    vocab_size: i32,
    max_token_length: i32,
    entryOff: MutSpan<i32>,
    sortedId: MutSpan<i32>,
}

fun cmpBytes(a: Span<u8>, b: Span<u8>) -> i32 {
    let la = std.mem.len(a)
    let lb = std.mem.len(b)
    let mut lim = la
    if lb < la {
        lim = lb
    }
    let mut res: i32 = 0
    let mut done = false
    let mut i: usize = 0
    while i < lim {
        if done == false {
            let ca = a[i]
            let cb = b[i]
            if ca < cb {
                res = 0 - 1
                done = true
                i = lim
            }
            if ca > cb {
                res = 1
                done = true
                i = lim
            }
        }
        if done == false {
            i = i + 1
        }
    }
    if done == false {
        if la < lb {
            res = 0 - 1
        }
        if la > lb {
            res = 1
        }
    }
    return res
}

fun cmpConcatEntry(a: Span<u8>, b: Span<u8>, v: Span<u8>) -> i32 {
    let la = std.mem.len(a)
    let lb = std.mem.len(b)
    let lab = la + lb
    let lv = std.mem.len(v)
    let mut lim = lab
    if lv < lab {
        lim = lv
    }
    let mut res: i32 = 0
    let mut done = false
    let mut i: usize = 0
    while i < lim {
        if done == false {
            let mut ce: u8 = 0
            if i < la {
                ce = a[i]
            }
            if i >= la {
                ce = b[i - la]
            }
            let cv = v[i]
            if ce < cv {
                res = 0 - 1
                done = true
                i = lim
            }
            if ce > cv {
                res = 1
                done = true
                i = lim
            }
        }
        if done == false {
            i = i + 1
        }
    }
    if done == false {
        if lab < lv {
            res = 0 - 1
        }
        if lab > lv {
            res = 1
        }
    }
    return res
}

fun entryStrAt(bytes: Span<u8>, off: usize) -> Span<u8> {
    let raw = std.codec.readI32Le(bytes, off + 4)
    let len = raw as usize
    let s = off + 8
    let e = s + len
    return bytes[s..e]
}

fun strById(bytes: Span<u8>, eo: MutSpan<i32>, id: i32) -> Span<u8> {
    let off = eo[id as usize] as usize
    return entryStrAt(bytes, off)
}

fun sortIdByStr(bytes: Span<u8>, eo: MutSpan<i32>, so: MutSpan<i32>) -> Void {
    let count = std.mem.len(so)
    if count < 2 {
        return
    }
    let mut bp: usize = count / 2
    while bp > 0 {
        let startNode = bp - 1
        let mut pos: usize = startNode
        let mut sifting = true
        while sifting {
            let left = pos * 2 + 1
            let right = pos * 2 + 2
            let mut largest = pos
            if left < count {
                let sl = strById(bytes, eo, so[left])
                let sb = strById(bytes, eo, so[largest])
                let c = cmpBytes(sl, sb)
                if c > 0 {
                    largest = left
                }
            }
            if right < count {
                let sr = strById(bytes, eo, so[right])
                let sb2 = strById(bytes, eo, so[largest])
                let c2 = cmpBytes(sr, sb2)
                if c2 > 0 {
                    largest = right
                }
            }
            let moved = largest != pos
            if moved {
                let ti = so[pos]
                so[pos] = so[largest]
                so[largest] = ti
                pos = largest
            }
            if moved == false {
                sifting = false
            }
        }
        bp = bp - 1
    }
    let mut ep: usize = count
    while ep > 1 {
        let end = ep - 1
        let ti2 = so[0]
        so[0] = so[end]
        so[end] = ti2
        let bound = end
        let mut pos2: usize = 0
        let mut sift2 = true
        while sift2 {
            let left2 = pos2 * 2 + 1
            let right2 = pos2 * 2 + 2
            let mut large2 = pos2
            if left2 < bound {
                let sl2 = strById(bytes, eo, so[left2])
                let sa = strById(bytes, eo, so[large2])
                let d = cmpBytes(sl2, sa)
                if d > 0 {
                    large2 = left2
                }
            }
            if right2 < bound {
                let sr2 = strById(bytes, eo, so[right2])
                let sa2 = strById(bytes, eo, so[large2])
                let d2 = cmpBytes(sr2, sa2)
                if d2 > 0 {
                    large2 = right2
                }
            }
            let moved2 = large2 != pos2
            if moved2 {
                let si = so[pos2]
                so[pos2] = so[large2]
                so[large2] = si
                pos2 = large2
            }
            if moved2 == false {
                sift2 = false
            }
        }
        ep = ep - 1
    }
}

fun buildTokenizer(bytes: Span<u8>, idx: MutSpan<i32>) -> Tok {
    let mtl = std.codec.readI32Le(bytes, 0)
    let total = std.mem.len(idx)
    let vocab = total / 2
    let entryOff: MutSpan<i32> = idx[0..vocab]
    let sortedId: MutSpan<i32> = idx[vocab..total]

    let mut cur: usize = 4
    let mut id: usize = 0
    while id < vocab {
        entryOff[id] = cur as i32
        sortedId[id] = id as i32
        let raw = std.codec.readI32Le(bytes, cur + 4)
        let len = raw as usize
        cur = cur + 8 + len
        id = id + 1
    }

    sortIdByStr(bytes, entryOff, sortedId)

    return Tok {
        bytes: bytes,
        vocab_size: vocab as i32,
        max_token_length: mtl,
        entryOff: entryOff,
        sortedId: sortedId
    }
}

fun tokenStr(t: Tok, id: i32) -> Span<u8> {
    return strById(t.bytes, t.entryOff, id)
}

fun findStr(t: Tok, s: Span<u8>) -> i32 {
    let bytes = t.bytes
    let eo = t.entryOff
    let so = t.sortedId
    let mut lo: usize = 0
    let mut hi: usize = t.vocab_size as usize
    let mut res: i32 = 0 - 1
    while lo < hi {
        let mid = (lo + hi) / 2
        let id = so[mid]
        let cand = strById(bytes, eo, id)
        let c = cmpBytes(s, cand)
        if c == 0 {
            res = id
            lo = hi
        }
        if c < 0 {
            hi = mid
        }
        if c > 0 {
            lo = mid + 1
        }
    }
    return res
}

fun findStrConcat(t: Tok, a: Span<u8>, b: Span<u8>) -> i32 {
    let bytes = t.bytes
    let eo = t.entryOff
    let so = t.sortedId
    let mut lo: usize = 0
    let mut hi: usize = t.vocab_size as usize
    let mut res: i32 = 0 - 1
    while lo < hi {
        let mid = (lo + hi) / 2
        let id = so[mid]
        let cand = strById(bytes, eo, id)
        let c = cmpConcatEntry(a, b, cand)
        if c == 0 {
            res = id
            lo = hi
        }
        if c < 0 {
            hi = mid
        }
        if c > 0 {
            lo = mid + 1
        }
    }
    return res
}

fun cpEnd(text: Span<u8>, start: usize) -> usize {
    let n = std.mem.len(text)
    let mut endi = start + 1
    let mut go = true
    while go {
        if endi >= n {
            go = false
        }
        if go {
            let span = endi - start
            if span >= 4 {
                go = false
            }
        }
        if go {
            let nb = text[endi]
            let ge = nb >= (128 as u8)
            let le = nb <= (191 as u8)
            let mut cont = false
            if ge {
                if le {
                    cont = true
                }
            }
            if cont {
                endi = endi + 1
            }
            if cont == false {
                go = false
            }
        }
    }
    return endi
}

fun encode(t: Tok, text: Span<u8>, out: MutSpan<i32>, bos: Bool) -> usize {
    let mut nTok: usize = 0
    if bos {
        out[nTok] = 1
        nTok = nTok + 1
    }

    let n = std.mem.len(text)
    if n > 0 {
        let sp = std.mem.span(" ")
        let spId = findStr(t, sp)
        if spId >= 0 {
            out[nTok] = spId
            nTok = nTok + 1
        }
    }

    let mut i: usize = 0
    while i < n {
        let endi = cpEnd(text, i)
        let cp = text[i..endi]
        let id = findStr(t, cp)
        if id >= 0 {
            out[nTok] = id
            nTok = nTok + 1
        }
        if id < 0 {
            let mut bi = i
            while bi < endi {
                let bv = text[bi]
                let tk = (bv as i32) + 3
                out[nTok] = tk
                nTok = nTok + 1
                bi = bi + 1
            }
        }
        i = endi
    }

    let mut more = true
    while more {
        let neg: f32 = 0.0 - 1000000000.0
        let mut bestScore: f32 = neg
        let mut bestId: i32 = 0 - 1
        let mut bestIdx: i32 = 0 - 1

        let mut p: usize = 0
        while p + 1 < nTok {
            let aId = out[p]
            let bId = out[p + 1]
            let a = tokenStr(t, aId)
            let b = tokenStr(t, bId)

            let mergeId = findStrConcat(t, a, b)
            if mergeId >= 0 {
                let eo = t.entryOff
                let off = eo[mergeId as usize] as usize
                let sc = std.codec.readF32Le(t.bytes, off)
                if sc > bestScore {
                    bestScore = sc
                    bestId = mergeId
                    bestIdx = p as i32
                }
            }
            p = p + 1
        }

        if bestIdx < 0 {
            more = false
        }
        if bestIdx >= 0 {
            let mi = bestIdx as usize
            out[mi] = bestId
            let mut k = mi + 1
            while k + 1 < nTok {
                out[k] = out[k + 1]
                k = k + 1
            }
            nTok = nTok - 1
        }
    }

    return nTok
}

fun decode(t: Tok, prev: i32, token: i32) -> Span<u8> {
    let piece = tokenStr(t, token)
    let plen = std.mem.len(piece)
    let mut lo: usize = 0
    if prev == 1 {
        if plen > 0 {
            let c0 = piece[0]
            let isSpace = c0 == (32 as u8)
            if isSpace {
                lo = 1
            }
        }
    }
    let res = piece[lo..plen]
    return res
}

pub fun main(world: World) -> Void raises {
    let data: [87]u8 = [5, 0, 0, 0, 0, 0, 0, 0, 5, 0, 0, 0, 60, 117, 110, 107, 62, 0, 0, 0, 0, 3, 0, 0, 0, 60, 115, 62, 0, 0, 0, 0, 4, 0, 0, 0, 60, 47, 115, 62, 0, 0, 64, 192, 1, 0, 0, 0, 32, 0, 0, 128, 192, 1, 0, 0, 0, 97, 0, 0, 160, 192, 1, 0, 0, 0, 98, 0, 0, 128, 191, 2, 0, 0, 0, 97, 98, 0, 0, 0, 192, 2, 0, 0, 0, 32, 97]
    let span: Span<u8> = data

    // One combined index region (2 * vocab = 16 i32s): first 8 = entry offsets,
    // last 8 = the string-sorted id list buildTokenizer produces.
    let mut idx: [16]i32 = [0_i32; 16]
    let idxp: MutSpan<i32> = idx
    let t = buildTokenizer(span, idxp)

    // sorted id order, ascending by byte string: " " < " a" < "</s>" < "<s>" <
    // "<unk>" < "a" < "ab" < "b"  =>  ids 3,7,2,1,0,4,6,5 (the second half of idx).
    let okSort = idx[8] == 3 && idx[9] == 7 && idx[10] == 2 && idx[11] == 1 && idx[12] == 0 && idx[13] == 4 && idx[14] == 6 && idx[15] == 5

    let prompt = std.mem.span("ab")

    // encode without BOS: dummy " " (id 3) + merge "a"+"b" -> "ab" (id 6) => [3, 6]
    let mut toks: [16]i32 = [0_i32; 16]
    let tspan: MutSpan<i32> = toks
    let n = encode(t, prompt, tspan, false)
    let t0 = tspan[0]
    let t1 = tspan[1]
    let okNoBos = n == 2
    let okT0 = t0 == 3
    let okT1 = t1 == 6

    // encode with BOS: [1, 3, 6]
    let mut toks2: [16]i32 = [0_i32; 16]
    let tspan2: MutSpan<i32> = toks2
    let n2 = encode(t, prompt, tspan2, true)
    let b0 = tspan2[0]
    let b2 = tspan2[2]
    let okBos = n2 == 3
    let okB0 = b0 == 1
    let okB2 = b2 == 6

    // decode: "ab" round-trips; " a" after BOS strips its leading space to "a"
    let ab = std.mem.span("ab")
    let a1 = std.mem.span("a")
    let sp1 = std.mem.span(" ")
    let d6 = decode(t, 0, 6)
    let d7 = decode(t, 1, 7)
    let d3 = decode(t, 0, 3)
    let okDecAb = std.mem.eqlBytes(d6, ab)
    let okDecStrip = std.mem.eqlBytes(d7, a1)
    let okDecSpace = std.mem.eqlBytes(d3, sp1)

    let okEnc = okNoBos && okT0 && okT1
    let okEncBos = okBos && okB0 && okB2
    let okDec = okDecAb && okDecStrip && okDecSpace
    if okSort && okEnc && okEncBos && okDec {
        check world.out.write("tokenizer encode ok\n")
    }
    return
}
