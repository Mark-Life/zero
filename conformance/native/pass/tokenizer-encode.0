// llama2 Phase 5: self-contained BPE tokenizer encode/decode.
//
// Self-contained mirror of examples/llama2/src/tokenizer.0 over a synthetic
// 8-token vocab held as a u8 array literal (no fs, so it runs in CI). The vocab
// is the Karpathy tokenizer.bin layout — [max_token_length:i32] then per token
// [score:f32][len:i32][bytes] — for:
//   0:"<unk>"(0)  1:"<s>"(0)  2:"</s>"(0)  3:" "(-3)
//   4:"a"(-4)     5:"b"(-5)   6:"ab"(-1)   7:" a"(-2)
//
// Checks: dummy-space prefix, single-char lookup, score-driven merge selection
// (pair "a"+"b"=>"ab" score -1 beats " "+"a"=>" a" score -2), BOS prepend, and
// decode with the post-BOS leading-space strip. Exercises sequential vocab walks,
// in-place concat matching, and i32 token stores into a fixed buffer.

shape Tok {
    bytes: Span<u8>,
    vocab_size: i32,
    max_token_length: i32,
}

fun buildTokenizer(bytes: Span<u8>, vocab_size: i32) -> Tok {
    let mtl = std.codec.readI32Le(bytes, 0)
    return Tok { bytes: bytes, vocab_size: vocab_size, max_token_length: mtl }
}

fun entryStart(bytes: Span<u8>, id: usize) -> usize {
    let mut cur: usize = 4
    let mut i: usize = 0
    while i < id {
        let raw = std.codec.readI32Le(bytes, cur + 4)
        let len = raw as usize
        cur = cur + 8 + len
        i = i + 1
    }
    return cur
}

fun tokenStr(t: Tok, id: i32) -> Span<u8> {
    let bytes = t.bytes
    let idu = id as usize
    let cur = entryStart(bytes, idu)
    let raw = std.codec.readI32Le(bytes, cur + 4)
    let len = raw as usize
    let s = cur + 8
    let e = s + len
    return bytes[s..e]
}

fun findStr(t: Tok, s: Span<u8>) -> i32 {
    let bytes = t.bytes
    let vocab = t.vocab_size as usize
    let mut cur: usize = 4
    let mut id: usize = 0
    while id < vocab {
        let raw = std.codec.readI32Le(bytes, cur + 4)
        let len = raw as usize
        let cs = cur + 8
        let ce = cs + len
        let cand = bytes[cs..ce]
        let eq = std.mem.eqlBytes(cand, s)
        if eq {
            return id as i32
        }
        cur = cur + 8 + len
        id = id + 1
    }
    return 0 - 1
}

fun concatMatch(cand: Span<u8>, a: Span<u8>, b: Span<u8>) -> Bool {
    let la = std.mem.len(a)
    let lb = std.mem.len(b)
    let lc = std.mem.len(cand)
    if lc != la + lb {
        return false
    }
    let head = cand[0..la]
    let tail = cand[la..lc]
    let okh = std.mem.eqlBytes(head, a)
    let okt = std.mem.eqlBytes(tail, b)
    return okh && okt
}

fun cpEnd(text: Span<u8>, start: usize) -> usize {
    let n = std.mem.len(text)
    let mut endi = start + 1
    let mut go = true
    while go {
        if endi >= n {
            go = false
        }
        if go {
            let span = endi - start
            if span >= 4 {
                go = false
            }
        }
        if go {
            let nb = text[endi]
            let ge = nb >= (128 as u8)
            let le = nb <= (191 as u8)
            let mut cont = false
            if ge {
                if le {
                    cont = true
                }
            }
            if cont {
                endi = endi + 1
            }
            if cont == false {
                go = false
            }
        }
    }
    return endi
}

fun encode(t: Tok, text: Span<u8>, out: MutSpan<i32>, bos: Bool) -> usize {
    let mut nTok: usize = 0
    if bos {
        out[nTok] = 1
        nTok = nTok + 1
    }

    let n = std.mem.len(text)
    if n > 0 {
        let sp = std.mem.span(" ")
        let spId = findStr(t, sp)
        if spId >= 0 {
            out[nTok] = spId
            nTok = nTok + 1
        }
    }

    let mut i: usize = 0
    while i < n {
        let endi = cpEnd(text, i)
        let cp = text[i..endi]
        let id = findStr(t, cp)
        if id >= 0 {
            out[nTok] = id
            nTok = nTok + 1
        }
        if id < 0 {
            let mut bi = i
            while bi < endi {
                let bv = text[bi]
                let tk = (bv as i32) + 3
                out[nTok] = tk
                nTok = nTok + 1
                bi = bi + 1
            }
        }
        i = endi
    }

    let mut more = true
    while more {
        let neg: f32 = 0.0 - 1000000000.0
        let mut bestScore: f32 = neg
        let mut bestId: i32 = 0 - 1
        let mut bestIdx: i32 = 0 - 1

        let mut p: usize = 0
        while p + 1 < nTok {
            let aId = out[p]
            let bId = out[p + 1]
            let a = tokenStr(t, aId)
            let b = tokenStr(t, bId)

            let bytes = t.bytes
            let vocab = t.vocab_size as usize
            let mut vcur: usize = 4
            let mut vid: usize = 0
            while vid < vocab {
                let raw = std.codec.readI32Le(bytes, vcur + 4)
                let len = raw as usize
                let cs = vcur + 8
                let ce = cs + len
                let cand = bytes[cs..ce]
                let m = concatMatch(cand, a, b)
                if m {
                    let sc = std.codec.readF32Le(bytes, vcur)
                    if sc > bestScore {
                        bestScore = sc
                        bestId = vid as i32
                        bestIdx = p as i32
                    }
                }
                vcur = vcur + 8 + len
                vid = vid + 1
            }
            p = p + 1
        }

        if bestIdx < 0 {
            more = false
        }
        if bestIdx >= 0 {
            let mi = bestIdx as usize
            out[mi] = bestId
            let mut k = mi + 1
            while k + 1 < nTok {
                out[k] = out[k + 1]
                k = k + 1
            }
            nTok = nTok - 1
        }
    }

    return nTok
}

fun decode(t: Tok, prev: i32, token: i32) -> Span<u8> {
    let piece = tokenStr(t, token)
    let plen = std.mem.len(piece)
    let mut lo: usize = 0
    if prev == 1 {
        if plen > 0 {
            let c0 = piece[0]
            let isSpace = c0 == (32 as u8)
            if isSpace {
                lo = 1
            }
        }
    }
    let res = piece[lo..plen]
    return res
}

pub fun main(world: World) -> Void raises {
    let data: [87]u8 = [5, 0, 0, 0, 0, 0, 0, 0, 5, 0, 0, 0, 60, 117, 110, 107, 62, 0, 0, 0, 0, 3, 0, 0, 0, 60, 115, 62, 0, 0, 0, 0, 4, 0, 0, 0, 60, 47, 115, 62, 0, 0, 64, 192, 1, 0, 0, 0, 32, 0, 0, 128, 192, 1, 0, 0, 0, 97, 0, 0, 160, 192, 1, 0, 0, 0, 98, 0, 0, 128, 191, 2, 0, 0, 0, 97, 98, 0, 0, 0, 192, 2, 0, 0, 0, 32, 97]
    let span: Span<u8> = data
    let t = buildTokenizer(span, 8)

    let prompt = std.mem.span("ab")

    // encode without BOS: dummy " " (id 3) + merge "a"+"b" -> "ab" (id 6) => [3, 6]
    let mut toks: [16]i32 = [0_i32; 16]
    let tspan: MutSpan<i32> = toks
    let n = encode(t, prompt, tspan, false)
    let t0 = tspan[0]
    let t1 = tspan[1]
    let okNoBos = n == 2
    let okT0 = t0 == 3
    let okT1 = t1 == 6

    // encode with BOS: [1, 3, 6]
    let mut toks2: [16]i32 = [0_i32; 16]
    let tspan2: MutSpan<i32> = toks2
    let n2 = encode(t, prompt, tspan2, true)
    let b0 = tspan2[0]
    let b2 = tspan2[2]
    let okBos = n2 == 3
    let okB0 = b0 == 1
    let okB2 = b2 == 6

    // decode: "ab" round-trips; " a" after BOS strips its leading space to "a"
    let ab = std.mem.span("ab")
    let a1 = std.mem.span("a")
    let sp1 = std.mem.span(" ")
    let d6 = decode(t, 0, 6)
    let d7 = decode(t, 1, 7)
    let d3 = decode(t, 0, 3)
    let okDecAb = std.mem.eqlBytes(d6, ab)
    let okDecStrip = std.mem.eqlBytes(d7, a1)
    let okDecSpace = std.mem.eqlBytes(d3, sp1)

    let okEnc = okNoBos && okT0 && okT1
    let okEncBos = okBos && okB0 && okB2
    let okDec = okDecAb && okDecStrip && okDecSpace
    if okEnc && okEncBos && okDec {
        check world.out.write("tokenizer encode ok\n")
    }
    return
}
