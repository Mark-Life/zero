# A fallible u64 return: the function declares `u64` and raises; the caller
# uses `check` + `rescue` to read the value (or fallback). Coverage gates the
# u64 type through the fallible call/return machinery and the rescue value
# slot. The success value fits in the lower 32 bits because the upstream
# direct backends pack the ok/err tag in the high 32 bits of the value GPR.

fn pickU64 u64 flag Bool ![Bad]
  if flag
    raise Bad
  let v u64 54321
  ret v

pub fn main Void world World !
  let ok u64 check (pickU64 false)
  let fallback u64 rescue (pickU64 true) err 7
  let expected u64 54321
  let seven u64 7
  if && (== ok expected) (== fallback seven)
    check world.out.write "fallible u64 ok\n"
