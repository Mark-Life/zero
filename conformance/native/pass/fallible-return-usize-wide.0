# A fallible usize return: the function declares `usize` and raises; the
# caller uses `check` to read the value. Coverage gates a usize success path
# through the fallible call/return machinery (the tag rides the value GPR's
# high 32 bits; usize values flow through the low 32 bits of that carrier).

fn bigLen usize flag Bool ![Bad]
  if flag
    raise Bad
  let v usize 5000000000
  ret v

pub fn main Void world World !
  let ok usize check (bigLen false)
  let expected usize 5000000000
  if == ok expected
    check world.out.write "fallible usize wide ok\n"
