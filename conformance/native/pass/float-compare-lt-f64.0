pub fun main(world: World) -> Void raises {
    let small: f64 = 1.0
    let big: f64 = 2.0
    let trueCase: Bool = small < big
    let falseCase: Bool = big < small
    let equalCase: Bool = small < small
    if trueCase && falseCase == false && equalCase == false {
        check world.out.write("float lt f64 ok\n")
    }
}
