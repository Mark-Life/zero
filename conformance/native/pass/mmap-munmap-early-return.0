fn firstFloat f32 fs Fs
  mut mapped Maybe<owned<Mapping>> std.fs.mmap fs ".zero/conformance/mmap-f32le.bin"
  if == mapped.has false
    let zero f32 0.0
    ret zero
  mut m owned<Mapping> mapped.value
  let bytes Span<u8> std.fs.mappingBytes (&m)
  let v0 f32 (std.codec.readF32Le bytes 0)
  if == (std.mem.len bytes) 12
    std.fs.munmap (&mut m)
    ret v0
  std.fs.munmap (&mut m)
  let zero f32 0.0
  ret zero

pub fn main Void world World !
  let fs std.fs.host()
  let v0 f32 firstFloat fs
  let one f32 1.0
  if == v0 one
    check world.out.write "mmap early return ok\n"
