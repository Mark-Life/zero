// Proves a hand-written program produces a correct process exit code from
// computed integer state, not just stdout. `export c fun main` is the freestanding
// entry: the direct backends wire its `i32` return into the platform's program-exit
// path (Mach-O `LC_MAIN`, ELF `_start`), so the value returned here becomes the
// process status the shell observes in `$?`.
//
// The result is computed (arithmetic + a helper call + a branch) rather than a bare
// literal, so a backend that mishandled register returns, call ABI, or comparison
// branches would yield the wrong status. classify(7 * 6) = classify(42): 42 is
// greater than 40 but not greater than 60, so the program exits with status 42.

fun classify(value: i32) -> i32 {
    if value > 60 {
        return value - 60
    }
    if value > 40 {
        return value
    }
    return 0
}

export c fun main() -> i32 {
    let total: i32 = 7 * 6
    return classify(total)
}
