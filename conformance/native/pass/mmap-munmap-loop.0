pub fun main(world: World) -> Void raises {
    let fs = std.fs.host()
    let one: f32 = 1.0
    let three: f32 = 3.0
    let mut ok: i32 = 0
    let mut i: i32 = 0
    while i < 1000 {
        let mut m: owned<Mapping> = check std.fs.mmapOrRaise(fs, "conformance/fixtures/mmap-f32le.bin")
        let bytes = std.fs.mappingBytes(&m)
        let v0: f32 = std.codec.readF32Le(bytes, 0)
        let v2: f32 = std.codec.readF32Le(bytes, 8)
        if std.mem.len(bytes) == 12 && v0 == one && v2 == three {
            ok = ok + 1
        }
        std.fs.munmap(&mut m)
        i = i + 1
    }
    if ok == 1000 {
        check world.out.write("mmap munmap loop ok\n")
    }
}
