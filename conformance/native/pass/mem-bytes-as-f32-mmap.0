pub fn main Void world World !
  let fs std.fs.host()
  mut mapped Maybe<owned<Mapping>> std.fs.mmap fs ".zero/conformance/mmap-f32le.bin"
  if == mapped.has false
    check world.out.write "mem bytes as f32 mmap failed\n"
    ret
  mut m owned<Mapping> mapped.value
  let bytes Span<u8> std.fs.mappingBytes (&m)
  let floats Span<f32> std.mem.bytesAsF32 bytes
  let v0 f32 floats[0]
  let v1 f32 floats[1]
  let v2 f32 floats[2]
  let tail Span<f32> std.mem.bytesAsF32 bytes[4..12]
  let t0 f32 tail[0]
  let t1 f32 tail[1]
  let one f32 1.0
  let two f32 2.0
  let three f32 3.0
  if && (&& (&& (&& (&& (&& (&& (== (std.mem.len bytes) 12) (== (std.mem.len floats) 3)) (== (std.mem.len tail) 2)) (== v0 one)) (== v1 two)) (== v2 three)) (== t0 two)) (== t1 three)
    check world.out.write "mem bytes as f32 mmap ok\n"
  std.fs.munmap (&mut m)
