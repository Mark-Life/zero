# Guards the fall-through error-tag clear in the two-register fallible ABI: a
# fallible Void function whose last operation (a division) clobbers rdx and then
# falls through with no explicit `ret`. The caller's `check` must still read
# success (the tag is cleared before the implicit epilogue), not a stale rdx.

fn maybeRaise i32 flag Bool ![Bad]
  if flag
    raise Bad
  ret 42

fn noisy Void a i32 b i32 ![Bad]
  let base i32 check (maybeRaise (== a 99))
  let q i32 + (/ a b) base
  if == q 99999
    raise Bad

pub fn main Void world World !
  check noisy 7 2
  check world.out.write "fallible void fallthrough ok\n"
