pub fun main(world: World) -> Void raises {
    let mut buffer: [3]f32 = [0.0, 0.0, 0.0]
    let input: [3]f32 = [1.0, 2.0, 3.0]
    let mut maxv: f32 = input[0]
    let mut i: usize = 1
    while i < 3 {
        if input[i] > maxv {
            maxv = input[i]
        }
        i = i + 1
    }
    let mut sum: f32 = 0.0
    let mut j: usize = 0
    while j < 3 {
        let e: f32 = std.math.expf(input[j] - maxv)
        buffer[j] = e
        sum = sum + e
        j = j + 1
    }
    let mut k: usize = 0
    while k < 3 {
        buffer[k] = buffer[k] / sum
        k = k + 1
    }
    let total: f32 = buffer[0] + buffer[1] + buffer[2]
    let okSum: Bool = total > 0.999 && total < 1.001
    let ok0: Bool = buffer[0] > 0.089 && buffer[0] < 0.091
    let ok1: Bool = buffer[1] > 0.243 && buffer[1] < 0.246
    let ok2: Bool = buffer[2] > 0.664 && buffer[2] < 0.667
    let ascending: Bool = buffer[0] < buffer[1] && buffer[1] < buffer[2]
    if okSum && ok0 && ok1 && ok2 && ascending {
        check world.out.write("math softmax ok\n")
    }
}
