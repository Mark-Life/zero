// Slicing a mutable span yields a mutable span (immutable spans stay immutable).
// This is what lets a pageAlloc'd byte region be sub-sliced and reinterpreted
// into writable f32 views — the mechanism RunState/forward rely on (llama2
// Phase 4). Covers: slice MutSpan<u8> -> MutSpan<u8> -> bytesAsMutF32 -> write;
// slice MutSpan<f32> -> MutSpan<f32> -> write through it and via a function that
// mutates the sub-slice (the per-head softmax pattern). No libm: runs in CI.

fun bump(x: MutSpan<f32>) -> Void {
    let n: usize = std.mem.len(x)
    let mut i: usize = 0
    while i < n {
        x[i] = x[i] + 1.0
        i = i + 1
    }
}

pub fun main(world: World) -> Void raises {
    let alloc = std.mem.pageAlloc()
    let region = std.mem.allocBytes(alloc, 64)
    if region.has {
        let base: MutSpan<u8> = region.value
        // (1) sub-slice the mutable byte region, reinterpret, write through it
        let half: MutSpan<u8> = base[0..32]
        let f: MutSpan<f32> = std.mem.bytesAsMutF32(half)
        f[0] = 1.0
        f[1] = 2.0
        f[2] = 3.0
        f[3] = 4.0
        // (2) sub-slice the mutable f32 view; write through the sub-slice
        let sub: MutSpan<f32> = f[1..3]
        sub[0] = sub[0] + 10.0
        // (3) pass the mutable sub-slice to a function that mutates it
        bump(sub)
        // f now: [1, 13, 4, 4, 0, 0, 0, 0]
        let all: MutSpan<f32> = std.mem.bytesAsMutF32(base)
        let v0: f32 = all[0]
        let v1: f32 = all[1]
        let v2: f32 = all[2]
        let v3: f32 = all[3]
        let tail: f32 = all[8]
        let ok0: Bool = v0 > 0.999 && v0 < 1.001
        let ok1: Bool = v1 > 12.999 && v1 < 13.001
        let ok2: Bool = v2 > 3.999 && v2 < 4.001
        let ok3: Bool = v3 > 3.999 && v3 < 4.001
        let okt: Bool = tail > 0.0 - 0.001 && tail < 0.001
        if ok0 && ok1 && ok2 && ok3 && okt {
            check world.out.write("mem mut span slice ok\n")
        }
    }
}
