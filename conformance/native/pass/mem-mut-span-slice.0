fn bump Void x MutSpan<f32>
  let n usize (std.mem.len x)
  mut i usize 0
  while < i n
    set x[i] (+ x[i] 1.0)
    set i (+ i 1)

pub fn main Void world World !
  mut heap PageAlloc std.mem.pageAlloc()
  let region std.mem.allocBytes heap 64
  if region.has
    let base MutSpan<u8> region.value
    let half MutSpan<u8> base[0..32]
    let f MutSpan<f32> std.mem.bytesAsMutF32 half
    set f[0] 1.0
    set f[1] 2.0
    set f[2] 3.0
    set f[3] 4.0
    let sub MutSpan<f32> f[1..3]
    set sub[0] (+ sub[0] 10.0)
    bump sub
    let all MutSpan<f32> std.mem.bytesAsMutF32 base
    let v0 f32 all[0]
    let v1 f32 all[1]
    let v2 f32 all[2]
    let v3 f32 all[3]
    let tail f32 all[8]
    let lo0 f32 0.999
    let hi0 f32 1.001
    let lo1 f32 12.999
    let hi1 f32 13.001
    let lo2 f32 3.999
    let hi2 f32 4.001
    let negEps f32 (- 0.0 0.001)
    let posEps f32 0.001
    let ok0 Bool (&& (> v0 lo0) (< v0 hi0))
    let ok1 Bool (&& (> v1 lo1) (< v1 hi1))
    let ok2 Bool (&& (> v2 lo2) (< v2 hi2))
    let ok3 Bool (&& (> v3 lo2) (< v3 hi2))
    let okt Bool (&& (> tail negEps) (< tail posEps))
    if && ok0 (&& ok1 (&& ok2 (&& ok3 okt)))
      check world.out.write "mem mut span slice ok\n"
