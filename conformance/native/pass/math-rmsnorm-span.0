fun rmsnorm(input: Span<f32>, weights: Span<f32>, output: MutSpan<f32>, eps: f32) -> Void {
    let n: usize = std.mem.len(input)
    let mut ss: f32 = 0.0
    let mut i: usize = 0
    while i < n {
        let v: f32 = input[i]
        ss = ss + v * v
        i = i + 1
    }
    let nf: f32 = (n as i32) as f32
    ss = ss / nf
    ss = ss + eps
    let inv: f32 = 1.0 / std.math.sqrtf(ss)
    let mut j: usize = 0
    while j < n {
        output[j] = weights[j] * (inv * input[j])
        j = j + 1
    }
}

pub fun main(world: World) -> Void raises {
    let input: [4]f32 = [3.0, 4.0, 0.0, 0.0]
    let weights: [4]f32 = [1.0, 1.0, 1.0, 1.0]
    let mut buffer: [4]f32 = [0.0, 0.0, 0.0, 0.0]
    let in_span: Span<f32> = input
    let w_span: Span<f32> = weights
    let out_span: MutSpan<f32> = buffer
    let eps: f32 = 0.00001
    rmsnorm(in_span, w_span, out_span, eps)
    let lo0: f32 = 1.199
    let hi0: f32 = 1.201
    let lo1: f32 = 1.599
    let hi1: f32 = 1.601
    let zeroLo: f32 = 0.0 - 0.001
    let zeroHi: f32 = 0.001
    let ok0: Bool = buffer[0] > lo0 && buffer[0] < hi0
    let ok1: Bool = buffer[1] > lo1 && buffer[1] < hi1
    let ok2: Bool = buffer[2] > zeroLo && buffer[2] < zeroHi
    let ok3: Bool = buffer[3] > zeroLo && buffer[3] < zeroHi
    if ok0 && ok1 && ok2 && ok3 {
        check world.out.write("math rmsnorm span ok\n")
    }
}
