fn pickF32 f32 flag Bool ![Bad]
  if flag
    raise Bad
  let v f32 2.5
  ret v

pub fn main Void world World !
  let ok f32 check (pickF32 false)
  let fallback f32 rescue (pickF32 true) err 9.0
  let expected f32 2.5
  let nine f32 9.0
  if && (== ok expected) (== fallback nine)
    check world.out.write "fallible f32 ok\n"
