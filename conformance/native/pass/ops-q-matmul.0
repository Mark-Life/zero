// Quantized (int8) matmul kernel — exact integer products + per-group rescale.
//
// Self-contained mirror of `matmulQ` (and its int8 sign-decode) from
// examples/llama2/src/ops.0, exercised on a tiny hand-computed case so it needs
// no filesystem and no libm and runs in CI. `matmulQ` is the byte-for-byte port
// of `runq.c`'s quantized matmul: W (d, n) @ x (n,) -> out (d,), both operands
// int8, accumulated as an exact int32 dot product within each group of `gs`
// quants then rescaled to f32 by that group's weight and activation scales.
//
// The case is d=2, n=4, gs=2 (so 2 groups per row, 4 weight scales, 2 activation
// scales). Weight quants are stored as raw bytes including values >= 128 to
// exercise the two's-complement sign-decode; activation quants are signed i32.
// Scales are exact powers of two (and 0.25) so every product and sum below is
// exact in f32, letting the assertions use exact `==`.
//
//   weight bytes  : [1, 2, 254, 128, 3, 0, 255, 127]
//   decoded (i8)  : [1, 2,  -2, -128, 3, 0,  -1, 127]
//   weight scales : [0.5, 0.25, 2.0, 1.0]   (d*n/gs = 4)
//   act quants    : [10, -3, 5, -7]         (n = 4, signed)
//   act scales    : [0.5, 4.0]              (n/gs = 2)
//
// Row 0 (row = 0):
//   group j=0: ival = 10*1 + (-3)*2          =   4; (4*0.5)*0.5      =     1.0
//   group j=2: ival =  5*(-2) + (-7)*(-128)  = 886; (886*0.25)*4.0   =   886.0
//   out[0] = 1.0 + 886.0                                             =   887.0
// Row 1 (row = 4):
//   group j=0: ival = 10*3 + (-3)*0          =  30; (30*2.0)*0.5     =    30.0
//   group j=2: ival =  5*(-1) + (-7)*127     = -894; (-894*1.0)*4.0  = -3576.0
//   out[1] = 30.0 + (-3576.0)                                        = -3546.0

// One matrix's int8 quants (raw bytes, signed values in two's complement) plus
// the f32 group scales.
shape QWeight {
    q: Span<u8>,
    s: Span<f32>,
}

// Quantized-activation scratch: signed int8 quants kept as i32 (no byte packing)
// plus the f32 group scales.
shape QActs {
    q: MutSpan<i32>,
    s: MutSpan<f32>,
}

// Reconstruct the signed value of an int8 weight byte with arithmetic only: for
// `uw` in 0..255, `uw / 128` is 1 exactly when the sign bit is set.
fun decodeI8(qb: u8) -> i32 {
    let uw: i32 = qb as i32
    let sw: i32 = uw - 256 * (uw / 128)
    return sw
}

// Port of examples/llama2/src/ops.0 `matmulQ` (see there for the parity notes):
// per-group int32 accumulate, reset each group, left-to-right f32 rescale.
fun matmulQ(out: MutSpan<f32>, x: QActs, w: QWeight, gs: usize) -> Void {
    let d: usize = std.mem.len(out)
    let n: usize = std.mem.len(x.q)
    let wq = w.q
    let ws = w.s
    let xq = x.q
    let xs = x.s
    let o = out
    let mut i: usize = 0
    while i < d {
        let row: usize = i * n
        let mut val: f32 = 0.0
        let mut j: usize = 0
        while j < n {
            let mut ival: i32 = 0
            let mut k: usize = 0
            while k < gs {
                let idx: usize = row + j + k
                let xqv: i32 = xq[j + k]
                let wsv: i32 = decodeI8(wq[idx])
                ival = ival + xqv * wsv
                k = k + 1
            }
            let wscale: f32 = ws[(row + j) / gs]
            let xscale: f32 = xs[j / gs]
            let ivalf: f32 = ival as f32
            val = val + (ivalf * wscale) * xscale
            j = j + gs
        }
        o[i] = val
        i = i + 1
    }
}

pub fun main(world: World) -> Void raises {
    // Weight quants as raw bytes (incl. >= 128 for sign-decode) and f32 scales.
    let wbytes: [8]u8 = [1, 2, 254, 128, 3, 0, 255, 127]
    let wscales: [4]f32 = [0.5, 0.25, 2.0, 1.0]
    let wq: Span<u8> = wbytes
    let ws: Span<f32> = wscales
    let w = QWeight {
        q: wq,
        s: ws
    }

    // Activation quants live in a writable i32 region (mirrors the run state);
    // activation scales in a writable f32 region. Fill both with known values.
    let alloc = std.mem.pageAlloc()
    let qregion = std.mem.allocBytes(alloc, 64)
    if qregion.has == false {
        return
    }
    let sregion = std.mem.allocBytes(alloc, 64)
    if sregion.has == false {
        return
    }
    let qbase: MutSpan<u8> = qregion.value
    let sbase: MutSpan<u8> = sregion.value
    let qints: MutSpan<i32> = std.mem.bytesAsMutI32(qbase)
    let sflts: MutSpan<f32> = std.mem.bytesAsMutF32(sbase)

    // Activation quants [10, -3, 5, -7] over the first 4 i32 slots.
    qints[0] = 10
    qints[1] = 0 - 3
    qints[2] = 5
    qints[3] = 0 - 7
    // Activation scales [0.5, 4.0] over the first 2 f32 slots.
    sflts[0] = 0.5
    sflts[1] = 4.0

    let xq: MutSpan<i32> = qints[0..4]
    let xs: MutSpan<f32> = sflts[0..2]
    let x = QActs {
        q: xq,
        s: xs
    }

    // Output region: 2 f32.
    let oregion = std.mem.allocBytes(alloc, 64)
    if oregion.has == false {
        return
    }
    let obase: MutSpan<u8> = oregion.value
    let oflts: MutSpan<f32> = std.mem.bytesAsMutF32(obase)
    let out: MutSpan<f32> = oflts[0..2]

    matmulQ(out, x, w, 2)

    // Both outputs are exact integers in f32 (all intermediates exact), so check
    // them exactly against the hand-computed values.
    let o0: f32 = out[0]
    let o1: f32 = out[1]
    let want0: f32 = 887.0
    let want1: f32 = 0.0 - 3546.0
    let okOut: Bool = o0 == want0 && o1 == want1

    // Sign-decode sanity on the boundary bytes used above.
    let okDecode: Bool = decodeI8(128) == (0 - 128) && decodeI8(254) == (0 - 2) && decodeI8(127) == 127 && decodeI8(0) == 0

    if okOut && okDecode {
        check world.out.write("ops q matmul ok\n")
    }
    return
}
