// llama2.zero — BPE tokenizer.
//
// Loads Karpathy's `tokenizer.bin` (already mmap'd into a byte span) and ports
// `llama2.c` `encode`/`decode`. The file layout is:
//
//   [max_token_length: i32]
//   per token (vocab_size of them):
//     [score: f32] [len: i32] [bytes: len]
//
// `vocab_size` is NOT in the file — it is the length of the caller-supplied index.
//
// `buildTokenizer` builds two load-time indices into a caller-allocated `pageAlloc`
// region (sized vocab), so lookups avoid scanning the whole vocab:
//   - `entryOff[id]` — byte offset of entry `id`, filled by ONE sequential walk.
//     Gives O(1) random access for `tokenStr` and score reads.
//   - `sortedId[]`  — token ids ordered ascending by their string (heapsort with a
//     string comparator + max-heap, same structure as sampler.0's `sortDescByProb`).
//     `findStr` and the merge-step lookup binary-search this index — O(log vocab)
//     instead of O(vocab), mirroring `llama2.c`'s `sorted_vocab` + `str_lookup`.
// Karpathy's vocab strings are unique (sentencepiece) and `llama2.c` itself
// binary-searches, so generation output is byte-for-byte identical to the C run.
//
// Two adaptations to the direct ELF64 backend:
//   - the merge candidate is matched against `vocab[a]+vocab[b]` WITHOUT building
//     the concatenation: `findStrConcat` binary-searches with `cmpConcatEntry`,
//     which compares the virtual a++b in place. No mutable byte scratch is needed,
//     and the binary search stays within the 6-integer-register call cap.
//   - `encode` takes BOS only (no EOS): the 6-integer-register call ABI can't fit
//     a 7th argument, and the prompt path needs only `encode(..., bos=1, eos=0)`
//     (as in `llama2.c` `run.c`) — EOS termination lives in the generation loop.

// A loaded tokenizer: the mapped file bytes, the header-derived sizes, and the two
// lookup indices (views into caller-owned pageAlloc regions; read-only after build).
// `max_token_length` is kept for fidelity to the format (it sizes `llama2.c`'s merge
// buffer, which the in-place `cmpConcatEntry` makes unnecessary here).
pub shape Tokenizer {
    bytes: Span<u8>,
    vocab_size: i32,
    max_token_length: i32,
    entryOff: MutSpan<i32>,
    sortedId: MutSpan<i32>,
}

// Lexicographic byte comparison: -1 if a < b, 1 if a > b, 0 if equal. The first
// differing byte decides; on a shared prefix the shorter span is smaller. Pure byte
// loop with a sentinel (`done` + `i = lim`) since the backend has no `break`.
fun cmpBytes(a: Span<u8>, b: Span<u8>) -> i32 {
    let la = std.mem.len(a)
    let lb = std.mem.len(b)
    let mut lim = la
    if lb < la {
        lim = lb
    }
    let mut res: i32 = 0
    let mut done = false
    let mut i: usize = 0
    while i < lim {
        if done == false {
            let ca = a[i]
            let cb = b[i]
            if ca < cb {
                res = 0 - 1
                done = true
                i = lim
            }
            if ca > cb {
                res = 1
                done = true
                i = lim
            }
        }
        if done == false {
            i = i + 1
        }
    }
    if done == false {
        if la < lb {
            res = 0 - 1
        }
        if la > lb {
            res = 1
        }
    }
    return res
}

// Lexicographic comparison of the concatenation a++b against `v`, WITHOUT building
// a++b: -1 if a++b < v, 1 if greater, 0 if equal. One index walks the virtual
// a-then-b sequence (length la+lb) against v; same sentinel-bound shape as cmpBytes.
fun cmpConcatEntry(a: Span<u8>, b: Span<u8>, v: Span<u8>) -> i32 {
    let la = std.mem.len(a)
    let lb = std.mem.len(b)
    let lab = la + lb
    let lv = std.mem.len(v)
    let mut lim = lab
    if lv < lab {
        lim = lv
    }
    let mut res: i32 = 0
    let mut done = false
    let mut i: usize = 0
    while i < lim {
        if done == false {
            let mut ce: u8 = 0
            if i < la {
                ce = a[i]
            }
            if i >= la {
                ce = b[i - la]
            }
            let cv = v[i]
            if ce < cv {
                res = 0 - 1
                done = true
                i = lim
            }
            if ce > cv {
                res = 1
                done = true
                i = lim
            }
        }
        if done == false {
            i = i + 1
        }
    }
    if done == false {
        if lab < lv {
            res = 0 - 1
        }
        if lab > lv {
            res = 1
        }
    }
    return res
}

// Zero-copy view of the token string for the entry that starts at byte `off`
// (its `len` is at off+4, the bytes at off+8).
fun entryStrAt(bytes: Span<u8>, off: usize) -> Span<u8> {
    let raw = std.codec.readI32Le(bytes, off + 4)
    let len = raw as usize
    let s = off + 8
    let e = s + len
    return bytes[s..e]
}

// Zero-copy view of token `id`'s string via the O(1) offset index.
fun strById(bytes: Span<u8>, eo: MutSpan<i32>, id: i32) -> Span<u8> {
    let off = eo[id as usize] as usize
    return entryStrAt(bytes, off)
}

// Sort `so` (token ids) ascending by token string, in place. Heapsort sharing the
// `sampler.0` `sortDescByProb` structure — sentinel-bound sift-down, no break, child
// = i*2+1 / i*2+2 — but over a SINGLE id array, keyed by the entry string (via
// `strById`/`cmpBytes`), and as a MAX-heap: extract-max-to-back fills the tail
// largest-first, leaving the array ascending (what the binary search consumes).
// `count` = len(so). The +1-shifted counters (`bp`, `ep`) keep usize from underflow.
fun sortIdByStr(bytes: Span<u8>, eo: MutSpan<i32>, so: MutSpan<i32>) -> Void {
    let count = std.mem.len(so)
    if count < 2 {
        return
    }
    let mut bp: usize = count / 2
    while bp > 0 {
        let startNode = bp - 1
        let mut pos: usize = startNode
        let mut sifting = true
        while sifting {
            let left = pos * 2 + 1
            let right = pos * 2 + 2
            let mut largest = pos
            if left < count {
                let sl = strById(bytes, eo, so[left])
                let sb = strById(bytes, eo, so[largest])
                let c = cmpBytes(sl, sb)
                if c > 0 {
                    largest = left
                }
            }
            if right < count {
                let sr = strById(bytes, eo, so[right])
                let sb2 = strById(bytes, eo, so[largest])
                let c2 = cmpBytes(sr, sb2)
                if c2 > 0 {
                    largest = right
                }
            }
            let moved = largest != pos
            if moved {
                let ti = so[pos]
                so[pos] = so[largest]
                so[largest] = ti
                pos = largest
            }
            if moved == false {
                sifting = false
            }
        }
        bp = bp - 1
    }
    let mut ep: usize = count
    while ep > 1 {
        let end = ep - 1
        let ti2 = so[0]
        so[0] = so[end]
        so[end] = ti2
        let bound = end
        let mut pos2: usize = 0
        let mut sift2 = true
        while sift2 {
            let left2 = pos2 * 2 + 1
            let right2 = pos2 * 2 + 2
            let mut large2 = pos2
            if left2 < bound {
                let sl2 = strById(bytes, eo, so[left2])
                let sa = strById(bytes, eo, so[large2])
                let d = cmpBytes(sl2, sa)
                if d > 0 {
                    large2 = left2
                }
            }
            if right2 < bound {
                let sr2 = strById(bytes, eo, so[right2])
                let sa2 = strById(bytes, eo, so[large2])
                let d2 = cmpBytes(sr2, sa2)
                if d2 > 0 {
                    large2 = right2
                }
            }
            let moved2 = large2 != pos2
            if moved2 {
                let si = so[pos2]
                so[pos2] = so[large2]
                so[large2] = si
                pos2 = large2
            }
            if moved2 == false {
                sift2 = false
            }
        }
        ep = ep - 1
    }
}

// Wrap an mmap'd `tokenizer.bin` byte span and build the lookup indices into one
// caller-allocated i32 region of `2 * vocab` elements — sliced into `entryOff`
// (first half) and `sortedId` (second half), so `vocab = len(idx) / 2`. A single
// combined region (rather than two) keeps this record-returning call at four
// integer arguments: the direct ELF64 backend reserves one register for the hidden
// return-struct pointer, capping such calls at five. One pass fills `entryOff[id]`
// and seeds `sortedId[id] = id`; `sortedId` is then heapsorted by token string.
pub fun buildTokenizer(bytes: Span<u8>, idx: MutSpan<i32>) -> Tokenizer {
    let mtl = std.codec.readI32Le(bytes, 0)
    let total = std.mem.len(idx)
    let vocab = total / 2
    let entryOff: MutSpan<i32> = idx[0..vocab]
    let sortedId: MutSpan<i32> = idx[vocab..total]

    let mut cur: usize = 4
    let mut id: usize = 0
    while id < vocab {
        entryOff[id] = cur as i32
        sortedId[id] = id as i32
        let raw = std.codec.readI32Le(bytes, cur + 4)
        let len = raw as usize
        cur = cur + 8 + len
        id = id + 1
    }

    sortIdByStr(bytes, entryOff, sortedId)

    return Tokenizer {
        bytes: bytes,
        vocab_size: vocab as i32,
        max_token_length: mtl,
        entryOff: entryOff,
        sortedId: sortedId
    }
}

// The token string for `id`, as a zero-copy view into the mapped file (O(1)).
fun tokenStr(t: Tokenizer, id: i32) -> Span<u8> {
    return strById(t.bytes, t.entryOff, id)
}

// Binary search the sorted index for the token whose string equals `s`; returns its
// id or -1, mirroring `llama2.c` `str_lookup`. Vocab strings are unique, so any
// match is unambiguous. A hit stores the id and sets
// `lo = hi` to end the loop (the backend has no `break`).
fun findStr(t: Tokenizer, s: Span<u8>) -> i32 {
    let bytes = t.bytes
    let eo = t.entryOff
    let so = t.sortedId
    let mut lo: usize = 0
    let mut hi: usize = t.vocab_size as usize
    let mut res: i32 = 0 - 1
    while lo < hi {
        let mid = (lo + hi) / 2
        let id = so[mid]
        let cand = strById(bytes, eo, id)
        let c = cmpBytes(s, cand)
        if c == 0 {
            res = id
            lo = hi
        }
        if c < 0 {
            hi = mid
        }
        if c > 0 {
            lo = mid + 1
        }
    }
    return res
}

// Binary search for the token whose string equals the concatenation a++b; returns
// its id or -1. The merge step's lookup: same sorted index + sentinel-exit as
// `findStr`, with `cmpConcatEntry` (which never
// materializes a++b) as the comparator.
fun findStrConcat(t: Tokenizer, a: Span<u8>, b: Span<u8>) -> i32 {
    let bytes = t.bytes
    let eo = t.entryOff
    let so = t.sortedId
    let mut lo: usize = 0
    let mut hi: usize = t.vocab_size as usize
    let mut res: i32 = 0 - 1
    while lo < hi {
        let mid = (lo + hi) / 2
        let id = so[mid]
        let cand = strById(bytes, eo, id)
        let c = cmpConcatEntry(a, b, cand)
        if c == 0 {
            res = id
            lo = hi
        }
        if c < 0 {
            hi = mid
        }
        if c > 0 {
            lo = mid + 1
        }
    }
    return res
}

// Exclusive end of the UTF-8 codepoint that starts at `start`: extend over up to
// three following continuation bytes. A continuation byte has its top two bits
// set to `10`, i.e. it lies in [128, 191] — `llama2.c` writes this as
// `(c & 0xC0) == 0x80`, rephrased here because `&` is the borrow operator.
fun cpEnd(text: Span<u8>, start: usize) -> usize {
    let n = std.mem.len(text)
    let mut endi = start + 1
    let mut go = true
    while go {
        if endi >= n {
            go = false
        }
        if go {
            let span = endi - start
            if span >= 4 {
                go = false
            }
        }
        if go {
            let nb = text[endi]
            let ge = nb >= (128 as u8)
            let le = nb <= (191 as u8)
            let mut cont = false
            if ge {
                if le {
                    cont = true
                }
            }
            if cont {
                endi = endi + 1
            }
            if cont == false {
                go = false
            }
        }
    }
    return endi
}

// BPE-encode `text` into `out`, returning the token count. Ported from `llama2.c`
// `encode`: optional BOS (=1), a dummy " " prefix token, per-codepoint vocab
// lookup with byte-fallback (`byte + 3`, since ids 0..2 are <unk>/<s>/</s>), then
// greedily merge the highest-scoring adjacent pair until none remain. `out` must
// hold at least `len(text) + 2 + (bos ? 1 : 0)` ids (one per byte, worst case).
pub fun encode(t: Tokenizer, text: Span<u8>, out: MutSpan<i32>, bos: Bool) -> usize {
    let mut nTok: usize = 0
    if bos {
        out[nTok] = 1
        nTok = nTok + 1
    }

    let n = std.mem.len(text)

    // add_dummy_prefix: a leading space token before the first real piece.
    if n > 0 {
        let sp = std.mem.span(" ")
        let spId = findStr(t, sp)
        if spId >= 0 {
            out[nTok] = spId
            nTok = nTok + 1
        }
    }

    // one token per codepoint (or per byte, on fallback)
    let mut i: usize = 0
    while i < n {
        let endi = cpEnd(text, i)
        let cp = text[i..endi]
        let id = findStr(t, cp)
        if id >= 0 {
            out[nTok] = id
            nTok = nTok + 1
        }
        if id < 0 {
            let mut bi = i
            while bi < endi {
                let bv = text[bi]
                let tk = (bv as i32) + 3
                out[nTok] = tk
                nTok = nTok + 1
                bi = bi + 1
            }
        }
        i = endi
    }

    // merge the best adjacent pair each pass until no vocab merge applies
    let mut more = true
    while more {
        let neg: f32 = 0.0 - 1000000000.0
        let mut bestScore: f32 = neg
        let mut bestId: i32 = 0 - 1
        let mut bestIdx: i32 = 0 - 1

        let mut p: usize = 0
        while p + 1 < nTok {
            let aId = out[p]
            let bId = out[p + 1]
            let a = tokenStr(t, aId)
            let b = tokenStr(t, bId)

            // O(log vocab) lookup of the merged token a+b (no concatenation built);
            // keep the highest-scoring mergeable pair, exactly as `llama2.c`. The
            // offset index is copied to a local before indexing: indexing the sliced
            // span record field directly (`t.entryOff[i]`) mis-resolves its base in
            // the direct backend, the same reason findStr/strById bind a local first.
            let mergeId = findStrConcat(t, a, b)
            if mergeId >= 0 {
                let eo = t.entryOff
                let off = eo[mergeId as usize] as usize
                let sc = std.codec.readF32Le(t.bytes, off)
                if sc > bestScore {
                    bestScore = sc
                    bestId = mergeId
                    bestIdx = p as i32
                }
            }
            p = p + 1
        }

        if bestIdx < 0 {
            more = false
        }
        if bestIdx >= 0 {
            let mi = bestIdx as usize
            out[mi] = bestId
            // delete out[mi+1], shifting the tail left one slot
            let mut k = mi + 1
            while k + 1 < nTok {
                out[k] = out[k + 1]
                k = k + 1
            }
            nTok = nTok - 1
        }
    }

    return nTok
}

// Value (0..15) of a single ASCII hex digit byte, or -1 if it is not a hex
// digit. Accepts both upper- and lower-case a-f.
fun hexDigit(b: u8) -> i32 {
    let v = b as i32
    let zero = 48 as i32
    let nine = 57 as i32
    if v >= zero {
        if v <= nine {
            return v - zero
        }
    }
    let bigA = 65 as i32
    let bigF = 70 as i32
    if v >= bigA {
        if v <= bigF {
            return v - bigA + 10
        }
    }
    let lowA = 97 as i32
    let lowF = 102 as i32
    if v >= lowA {
        if v <= lowF {
            return v - lowA + 10
        }
    }
    return 0 - 1
}

// The display bytes for `token`. Mirrors `llama2.c` `decode`: after BOS
// (prev == 1) a single leading space is stripped (the sentencepiece dummy-prefix
// convention), and a raw-byte fallback token of the form `<0xNN>` decodes to the
// single byte 0xNN. `scratch` is caller-owned writable storage (>= 1 byte) used
// to hold that one decoded byte so the returned span outlives this call; for all
// other tokens the result is a zero-copy view into the mapped vocab.
pub fun decode(t: Tokenizer, prev: i32, token: i32, scratch: MutSpan<u8>) -> Span<u8> {
    let piece = tokenStr(t, token)
    let plen = std.mem.len(piece)

    // Strip a single sentencepiece dummy-prefix space right after BOS first, then
    // inspect the resulting window — the same order as `llama2.c` `decode`.
    let mut lo: usize = 0
    if prev == 1 {
        if plen > 0 {
            let c0 = piece[0]
            let isSpace = c0 == (32 as u8)
            if isSpace {
                lo = 1
            }
        }
    }

    // Raw-byte fallback: a `<0xNN>` window (exactly 6 bytes) -> the single byte
    // 0xNN, matching `llama2.c`'s `sscanf(piece, "<0x%02hhX>", ...)`.
    let span = plen - lo
    if span == 6 {
        let lt = piece[lo] == (60 as u8)
        let z0 = piece[lo + 1] == (48 as u8)
        let xc = piece[lo + 2] == (120 as u8)
        let gt = piece[lo + 5] == (62 as u8)
        if lt {
            if z0 {
                if xc {
                    if gt {
                        let hi = hexDigit(piece[lo + 3])
                        let lo2 = hexDigit(piece[lo + 4])
                        if hi >= 0 {
                            if lo2 >= 0 {
                                let val = hi * 16 + lo2
                                scratch[0] = val as u8
                                let one = scratch[0..1]
                                return one
                            }
                        }
                    }
                }
            }
        }
    }

    let res = piece[lo..plen]
    return res
}
