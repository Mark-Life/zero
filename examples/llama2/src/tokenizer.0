# llama2.zero — BPE tokenizer.
#
# Loads Karpathy's `tokenizer.bin` (already mmap'd into a byte span) and ports
# `llama2.c` `encode`/`decode`. The file layout is:
#
#   [max_token_length: i32]
#   per token (vocab_size of them):
#     [score: f32] [len: i32] [bytes: len]
#
# `vocab_size` is NOT in the file — it is the length of the caller-supplied index.
#
# `buildTokenizer` builds two load-time indices into a caller-allocated `pageAlloc`
# region (sized vocab), so lookups avoid scanning the whole vocab:
#   - `entryOff[id]` — byte offset of entry `id`, filled by ONE sequential walk.
#     Gives O(1) random access for `tokenStr` and score reads.
#   - `sortedId[]`  — token ids ordered ascending by their string (heapsort with a
#     string comparator + max-heap).
#     `findStr` and the merge-step lookup binary-search this index — O(log vocab)
#     instead of O(vocab), mirroring `llama2.c`'s `sorted_vocab` + `str_lookup`.
# Karpathy's vocab strings are unique (sentencepiece) and `llama2.c` itself
# binary-searches, so generation output is byte-for-byte identical to the C run.
#
# Two adaptations to the direct ELF64 backend:
#   - the merge candidate is matched against `vocab[a]+vocab[b]` WITHOUT building
#     the concatenation: `findStrConcat` binary-searches with `cmpConcatEntry`,
#     which compares the virtual a++b in place. No mutable byte scratch is needed,
#     and the binary search stays within the 6-integer-register call cap.
#   - `encode` takes BOS only (no EOS): the 6-integer-register call ABI can't fit
#     a 7th argument, and the prompt path needs only `encode(..., bos=1, eos=0)`
#     (as in `llama2.c` `run.c`) — EOS termination lives in the generation loop.

# A loaded tokenizer: the mapped file bytes, the header-derived sizes, and the two
# lookup indices (views into caller-owned pageAlloc regions; read-only after build).
# `max_token_length` is kept for fidelity to the format (it sizes `llama2.c`'s merge
# buffer, which the in-place `cmpConcatEntry` makes unnecessary here).
type Tokenizer
  bytes Span<u8>
  vocab_size i32
  max_token_length i32
  entryOff MutSpan<i32>
  sortedId MutSpan<i32>

# Lexicographic byte comparison: -1 if a < b, 1 if a > b, 0 if equal. The first
# differing byte decides; on a shared prefix the shorter span is smaller. Pure byte
# loop with a sentinel (`done` + `i = lim`) since the backend has no `break`.
fn cmpBytes i32 a Span<u8> b Span<u8>
  let la usize std.mem.len a
  let lb usize std.mem.len b
  mut lim usize la
  if < lb la
    set lim lb
  mut res i32 0
  mut done Bool false
  mut i usize 0
  while < i lim
    if == done false
      let ca u8 a[i]
      let cb u8 b[i]
      if < ca cb
        set res (- 0 1)
        set done true
        set i lim
      if > ca cb
        set res 1
        set done true
        set i lim
    if == done false
      set i + i 1
  if == done false
    if < la lb
      set res (- 0 1)
    if > la lb
      set res 1
  ret res

# Lexicographic comparison of the concatenation a++b against `v`, WITHOUT building
# a++b: -1 if a++b < v, 1 if greater, 0 if equal. One index walks the virtual
# a-then-b sequence (length la+lb) against v; same sentinel-bound shape as cmpBytes.
fn cmpConcatEntry i32 a Span<u8> b Span<u8> v Span<u8>
  let la usize std.mem.len a
  let lb usize std.mem.len b
  let lab usize + la lb
  let lv usize std.mem.len v
  mut lim usize lab
  if < lv lab
    set lim lv
  mut res i32 0
  mut done Bool false
  mut i usize 0
  while < i lim
    if == done false
      mut ce u8 0
      if < i la
        set ce a[i]
      if >= i la
        set ce b[(- i la)]
      let cv u8 v[i]
      if < ce cv
        set res (- 0 1)
        set done true
        set i lim
      if > ce cv
        set res 1
        set done true
        set i lim
    if == done false
      set i + i 1
  if == done false
    if < lab lv
      set res (- 0 1)
    if > lab lv
      set res 1
  ret res

# Zero-copy view of the token string for the entry that starts at byte `off`
# (its `len` is at off+4, the bytes at off+8).
fn entryStrAt Span<u8> bytes Span<u8> off usize
  let raw i32 std.codec.readI32Le bytes (+ off 4)
  let len usize (raw as usize)
  let s usize + off 8
  let e usize + s len
  ret bytes[s..e]

# Zero-copy view of token `id`'s string via the O(1) offset index.
fn strById Span<u8> bytes Span<u8> eo MutSpan<i32> id i32
  let off usize (eo[(id as usize)] as usize)
  ret entryStrAt bytes off

# Sort `so` (token ids) ascending by token string, in place. Heapsort with a
# sentinel-bound sift-down (no break), child = i*2+1 / i*2+2, over a SINGLE id
# array keyed by the entry string (via `strById`/`cmpBytes`), and as a MAX-heap:
# extract-max-to-back fills the tail largest-first, leaving the array ascending
# (what the binary search consumes). `count` = len(so). The +1-shifted counters
# (`bp`, `ep`) keep usize from underflow.
fn sortIdByStr Void bytes Span<u8> eo MutSpan<i32> so MutSpan<i32>
  let count usize std.mem.len so
  if < count 2
    ret
  mut bp usize / count 2
  while > bp 0
    let startNode usize - bp 1
    mut pos usize startNode
    mut sifting Bool true
    while sifting
      let left usize + (* pos 2) 1
      let right usize + (* pos 2) 2
      mut largest usize pos
      if < left count
        let sl Span<u8> strById bytes eo so[left]
        let sb Span<u8> strById bytes eo so[largest]
        let c i32 cmpBytes sl sb
        if > c 0
          set largest left
      if < right count
        let sr Span<u8> strById bytes eo so[right]
        let sb2 Span<u8> strById bytes eo so[largest]
        let c2 i32 cmpBytes sr sb2
        if > c2 0
          set largest right
      let moved Bool != largest pos
      if moved
        let ti i32 so[pos]
        set so[pos] so[largest]
        set so[largest] ti
        set pos largest
      if == moved false
        set sifting false
    set bp - bp 1
  mut ep usize count
  while > ep 1
    let end usize - ep 1
    let ti2 i32 so[0]
    set so[0] so[end]
    set so[end] ti2
    let bound usize end
    mut pos2 usize 0
    mut sift2 Bool true
    while sift2
      let left2 usize + (* pos2 2) 1
      let right2 usize + (* pos2 2) 2
      mut large2 usize pos2
      if < left2 bound
        let sl2 Span<u8> strById bytes eo so[left2]
        let sa Span<u8> strById bytes eo so[large2]
        let d i32 cmpBytes sl2 sa
        if > d 0
          set large2 left2
      if < right2 bound
        let sr2 Span<u8> strById bytes eo so[right2]
        let sa2 Span<u8> strById bytes eo so[large2]
        let d2 i32 cmpBytes sr2 sa2
        if > d2 0
          set large2 right2
      let moved2 Bool != large2 pos2
      if moved2
        let si i32 so[pos2]
        set so[pos2] so[large2]
        set so[large2] si
        set pos2 large2
      if == moved2 false
        set sift2 false
    set ep - ep 1

# Wrap an mmap'd `tokenizer.bin` byte span and build the lookup indices into one
# caller-allocated i32 region of `2 * vocab` elements — sliced into `entryOff`
# (first half) and `sortedId` (second half), so `vocab = len(idx) / 2`. A single
# combined region (rather than two) keeps this record-returning call at four
# integer arguments: the direct ELF64 backend reserves one register for the hidden
# return-struct pointer, capping such calls at five. One pass fills `entryOff[id]`
# and seeds `sortedId[id] = id`; `sortedId` is then heapsorted by token string.
pub fn buildTokenizer Tokenizer bytes Span<u8> idx MutSpan<i32>
  let mtl i32 std.codec.readI32Le bytes 0
  let total usize std.mem.len idx
  let vocab usize / total 2
  let entryOff MutSpan<i32> idx[0..vocab]
  let sortedId MutSpan<i32> idx[vocab..total]

  mut cur usize 4
  mut id usize 0
  while < id vocab
    set entryOff[id] (cur as i32)
    set sortedId[id] (id as i32)
    let raw i32 std.codec.readI32Le bytes (+ cur 4)
    let len usize (raw as usize)
    set cur + (+ cur 8) len
    set id + id 1

  sortIdByStr bytes entryOff sortedId

  let tk Tokenizer . bytes bytes vocab_size (vocab as i32) max_token_length mtl entryOff entryOff sortedId sortedId
  ret tk

# The token string for `id`, as a zero-copy view into the mapped file (O(1)).
fn tokenStr Span<u8> t Tokenizer id i32
  let bytes Span<u8> t.bytes
  let eo MutSpan<i32> t.entryOff
  ret strById bytes eo id

# Binary search the sorted index for the token whose string equals `s`; returns its
# id or -1, mirroring `llama2.c` `str_lookup`. Vocab strings are unique, so any
# match is unambiguous. A hit stores the id and sets
# `lo = hi` to end the loop (the backend has no `break`).
fn findStr i32 t Tokenizer s Span<u8>
  let bytes Span<u8> t.bytes
  let eo MutSpan<i32> t.entryOff
  let so MutSpan<i32> t.sortedId
  mut lo usize 0
  mut hi usize (t.vocab_size as usize)
  mut res i32 (- 0 1)
  while < lo hi
    let mid usize / (+ lo hi) 2
    let id i32 so[mid]
    let cand Span<u8> strById bytes eo id
    let c i32 cmpBytes s cand
    if == c 0
      set res id
      set lo hi
    if < c 0
      set hi mid
    if > c 0
      set lo + mid 1
  ret res

# Binary search for the token whose string equals the concatenation a++b; returns
# its id or -1. The merge step's lookup: same sorted index + sentinel-exit as
# `findStr`, with `cmpConcatEntry` (which never
# materializes a++b) as the comparator.
fn findStrConcat i32 t Tokenizer a Span<u8> b Span<u8>
  let bytes Span<u8> t.bytes
  let eo MutSpan<i32> t.entryOff
  let so MutSpan<i32> t.sortedId
  mut lo usize 0
  mut hi usize (t.vocab_size as usize)
  mut res i32 (- 0 1)
  while < lo hi
    let mid usize / (+ lo hi) 2
    let id i32 so[mid]
    let cand Span<u8> strById bytes eo id
    let c i32 cmpConcatEntry a b cand
    if == c 0
      set res id
      set lo hi
    if < c 0
      set hi mid
    if > c 0
      set lo + mid 1
  ret res

# Exclusive end of the UTF-8 codepoint that starts at `start`: extend over up to
# three following continuation bytes. A continuation byte has its top two bits
# set to `10`, i.e. it lies in [128, 191] — `llama2.c` writes this as
# `(c & 0xC0) == 0x80`, rephrased here because `&` is the borrow operator.
fn cpEnd usize text Span<u8> start usize
  let n usize std.mem.len text
  mut endi usize + start 1
  mut go Bool true
  while go
    if >= endi n
      set go false
    if go
      let span usize - endi start
      if >= span 4
        set go false
    if go
      let nb u8 text[endi]
      let ge Bool >= nb (128 as u8)
      let le Bool <= nb (191 as u8)
      mut cont Bool false
      if ge
        if le
          set cont true
      if cont
        set endi + endi 1
      if == cont false
        set go false
  ret endi

# BPE-encode `text` into `out`, returning the token count. Ported from `llama2.c`
# `encode`: optional BOS (=1), a dummy " " prefix token, per-codepoint vocab
# lookup with byte-fallback (`byte + 3`, since ids 0..2 are <unk>/<s>/</s>), then
# greedily merge the highest-scoring adjacent pair until none remain. `out` must
# hold at least `len(text) + 2 + (bos ? 1 : 0)` ids (one per byte, worst case).
pub fn encode usize t Tokenizer text Span<u8> out MutSpan<i32> bos Bool
  mut nTok usize 0
  if bos
    set out[nTok] 1
    set nTok + nTok 1

  let n usize std.mem.len text

  # add_dummy_prefix: a leading space token before the first real piece. Only
  # emitted when " " resolves to a real id; a sentencepiece vocab always has it,
  # so this matches `llama2.c` for any real model while avoiding pushing an
  # invalid (-1) id into the token stream for a degenerate vocab that lacks it.
  if > n 0
    let sp Span<u8> std.mem.span " "
    let spId i32 findStr t sp
    if >= spId 0
      set out[nTok] spId
      set nTok + nTok 1

  # one token per codepoint (or per byte, on fallback)
  mut i usize 0
  while < i n
    let endi usize cpEnd text i
    let cp Span<u8> text[i..endi]
    let id i32 findStr t cp
    if >= id 0
      set out[nTok] id
      set nTok + nTok 1
    if < id 0
      mut bi usize i
      while < bi endi
        let bv u8 text[bi]
        let tk i32 + (bv as i32) 3
        set out[nTok] tk
        set nTok + nTok 1
        set bi + bi 1
    set i endi

  # merge the best adjacent pair each pass until no vocab merge applies
  mut more Bool true
  while more
    let neg f32 - 0.0 1000000000.0
    mut bestScore f32 neg
    mut bestId i32 (- 0 1)
    mut bestIdx i32 (- 0 1)

    mut p usize 0
    while < (+ p 1) nTok
      let aId i32 out[p]
      let bId i32 out[(+ p 1)]
      let a Span<u8> tokenStr t aId
      let b Span<u8> tokenStr t bId

      # O(log vocab) lookup of the merged token a+b (no concatenation built);
      # keep the highest-scoring mergeable pair, exactly as `llama2.c`. The
      # offset index is copied to a local before indexing: indexing the sliced
      # span record field directly (`t.entryOff[i]`) mis-resolves its base in
      # the direct backend, the same reason findStr/strById bind a local first.
      let mergeId i32 findStrConcat t a b
      if >= mergeId 0
        let eo MutSpan<i32> t.entryOff
        let off usize (eo[(mergeId as usize)] as usize)
        let sc f32 std.codec.readF32Le t.bytes off
        if > sc bestScore
          set bestScore sc
          set bestId mergeId
          set bestIdx (p as i32)
      set p + p 1

    if < bestIdx 0
      set more false
    if >= bestIdx 0
      let mi usize (bestIdx as usize)
      set out[mi] bestId
      # delete out[mi+1], shifting the tail left one slot
      mut k usize + mi 1
      while < (+ k 1) nTok
        set out[k] out[(+ k 1)]
        set k + k 1
      set nTok - nTok 1

  ret nTok

# Value (0..15) of a single ASCII hex digit byte, or -1 if it is not a hex
# digit. Accepts both upper- and lower-case a-f.
fn hexDigit i32 b u8
  let v i32 (b as i32)
  let zero i32 (48 as i32)
  let nine i32 (57 as i32)
  if >= v zero
    if <= v nine
      ret - v zero
  let bigA i32 (65 as i32)
  let bigF i32 (70 as i32)
  if >= v bigA
    if <= v bigF
      ret + (- v bigA) 10
  let lowA i32 (97 as i32)
  let lowF i32 (102 as i32)
  if >= v lowA
    if <= v lowF
      ret + (- v lowA) 10
  ret - 0 1

# The display bytes for `token`. Mirrors `llama2.c` `decode`: after BOS
# (prev == 1) a single leading space is stripped (the sentencepiece dummy-prefix
# convention), and a raw-byte fallback token of the form `<0xNN>` decodes to the
# single byte 0xNN. `scratch` is caller-owned writable storage (>= 1 byte) used
# to hold that one decoded byte so the returned span outlives this call; for all
# other tokens the result is a zero-copy view into the mapped vocab.
pub fn decode Span<u8> t Tokenizer prev i32 token i32 scratch MutSpan<u8>
  let piece Span<u8> tokenStr t token
  let plen usize std.mem.len piece

  # Strip a single sentencepiece dummy-prefix space right after BOS first, then
  # inspect the resulting window — the same order as `llama2.c` `decode`.
  mut lo usize 0
  if == prev 1
    if > plen 0
      let c0 u8 piece[0]
      let isSpace Bool == c0 (32 as u8)
      if isSpace
        set lo 1

  # Raw-byte fallback: a `<0xNN>` window (exactly 6 bytes) -> the single byte
  # 0xNN, matching `llama2.c`'s `sscanf(piece, "<0x%02hhX>", ...)`.
  let span usize - plen lo
  if == span 6
    let lt Bool == piece[lo] (60 as u8)
    let z0 Bool == piece[(+ lo 1)] (48 as u8)
    let xc Bool == piece[(+ lo 2)] (120 as u8)
    let gt Bool == piece[(+ lo 5)] (62 as u8)
    if lt
      if z0
        if xc
          if gt
            let hi i32 hexDigit piece[(+ lo 3)]
            let lo2 i32 hexDigit piece[(+ lo 4)]
            if >= hi 0
              if >= lo2 0
                let val i32 + (* hi 16) lo2
                set scratch[0] (val as u8)
                let one Span<u8> scratch[0..1]
                ret one

  let res Span<u8> piece[lo..plen]
  ret res
