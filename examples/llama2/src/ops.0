# llama2.zero — forward-pass math kernels.
#
# The five f32 forward-pass primitives, ported one-to-one from llama2.c:
# RMSNorm, matmul, softmax, RoPE, and the SwiGLU non-linearity. All are pure
# functions over Span<f32> / MutSpan<f32> — dimensions are read from the span
# lengths, so the caller (transformer) slices the right tensor view and the
# kernel needs no separate size arguments. Weights arrive as the zero-copy
# Span<f32> views built in checkpoint.
#
# Alongside them are three int8-quantized kernels (matmulQ, quantizeActs,
# dequantRow), ported one-to-one from runq.c, used by the quantized forward
# pass: a quantized matmul over int8 weights and int8 activations, a per-group
# symmetric activation quantizer, and a single-row weight dequantizer (the token
# embedding gather). They take an explicit group size gs because the
# quantization groups span the matmul inner dimension. The int8 math is integer
# up to a per-group f32 rescale, so it must reproduce runq.c's operation order
# bit-for-bit (see the notes on each).
#
# Numerics track llama2.c / runq.c exactly (same operation order, libm via
# std.math), so a temperature-0 run reproduces the C token stream.

use checkpoint

# RMSNorm: output[j] = weights[j] * input[j] / sqrt(mean(input^2) + eps).
# Mirrors rmsnorm(o, x, weight, size) with size taken from input. eps is the
# reference's hardcoded 1e-5f, passed in so the caller owns the constant.
pub fn rmsnorm Void output MutSpan<f32> input Span<f32> weights Span<f32> eps f32
  let n usize std.mem.len input
  mut ss f32 0.0
  mut i usize 0
  while < i n
    let v f32 input[i]
    set ss + ss (* v v)
    set i + i 1
  let nf f32 ((n as i32) as f32)
  set ss / ss nf
  set ss + ss eps
  let inv f32 / 1.0 (std.math.sqrtf ss)
  mut j usize 0
  while < j n
    set output[j] (* weights[j] (* inv input[j]))
    set j + j 1

# matmul: W (d, n) @ x (n,) -> output (d,), row-major weights. d and n come from
# the output and input span lengths; weights must hold d*n elements. This is the
# forward pass's hot loop — weights is a plain Span<f32> view so each access is a
# bare load with one bounds check, no per-element fat-pointer math.
pub fn matmul Void output MutSpan<f32> input Span<f32> weights Span<f32>
  let d usize std.mem.len output
  let n usize std.mem.len input
  mut i usize 0
  while < i d
    let row usize * i n
    mut val f32 0.0
    mut j usize 0
    while < j n
      let idx usize + row j
      set val + val (* weights[idx] input[j])
      set j + j 1
    set output[i] val
    set i + i 1

# softmax in place over x, with the standard max-subtraction for numerical
# stability. Mirrors softmax(x, size); the attention path calls it on a
# MutSpan<f32> slice of the score buffer. Assumes a non-empty span (the reference
# reads x[0] unconditionally).
pub fn softmax Void x MutSpan<f32>
  let n usize std.mem.len x
  mut maxv f32 x[0]
  mut i usize 1
  while < i n
    if > x[i] maxv
      set maxv x[i]
    set i + i 1
  mut sum f32 0.0
  mut j usize 0
  while < j n
    let e f32 std.math.expf (- x[j] maxv)
    set x[j] e
    set sum + sum e
    set j + j 1
  mut k usize 0
  while < k n
    set x[k] / x[k] sum
    set k + k 1

# RoPE: rotate consecutive (even, odd) pairs of vec in place by the
# position-dependent angle. Mirrors the rotation llama2.c applies to q and k;
# call it once per vector — q has dim elements, k has kv_dim. Because the
# frequency depends only on head_dim = idx % head_size, rotating each vector over
# its own length reproduces the reference's rotation (q for all i, k only for
# i < kv_dim) exactly. head_size must be even.
pub fn rope Void vec MutSpan<f32> pos i32 head_size usize
  let n usize std.mem.len vec
  let posf f32 (pos as f32)
  let hsf f32 ((head_size as i32) as f32)
  let base f32 10000.0
  mut i usize 0
  while < i n
    let head_dim usize % i head_size
    let hd f32 ((head_dim as i32) as f32)
    let exponent f32 / hd hsf
    let denom f32 std.math.powf base exponent
    let freq f32 / 1.0 denom
    let val f32 * posf freq
    let fcr f32 std.math.cosf val
    let fci f32 std.math.sinf val
    let i1 usize + i 1
    let v0 f32 vec[i]
    let v1 f32 vec[i1]
    set vec[i] (- (* v0 fcr) (* v1 fci))
    set vec[i1] (+ (* v0 fci) (* v1 fcr))
    set i + i 2

# SwiGLU non-linearity in place: hb[i] = silu(hb[i]) * hb2[i], where
# silu(v) = v * sigmoid(v) = v / (1 + exp(-v)). Mirrors the FFN gate combine in
# llama2.c (hb holds w1(x), hb2 holds w3(x)).
pub fn swiglu Void hb MutSpan<f32> hb2 Span<f32>
  let n usize std.mem.len hb
  mut i usize 0
  while < i n
    let v f32 hb[i]
    let negv f32 - 0.0 v
    let e f32 std.math.expf negv
    let denom f32 + 1.0 e
    let sig f32 / 1.0 denom
    let silu f32 * v sig
    let g f32 hb2[i]
    set hb[i] (* silu g)
    set i + i 1

# Quantized-activation scratch, writable. Mirrors runq.c's QuantizedTensor for
# the activation side: q holds the signed int8 quants as a MutSpan<i8> (one byte
# per value, matching runq.c's int8_t*), and s holds the f32 group scales (one
# per run of group_size quants). Filled by quantizeActs and consumed by matmulQ.
# Lives in the run state, so both fields are MutSpan.
type QActs
  q MutSpan<i8>
  s MutSpan<f32>

# Round half away from zero, matching C's round() — used by the activation
# quantizer because std.math has no roundf. For the quantizer's operating range
# this is exact: the argument is x / scale with scale = max(|x|) / 127, so its
# magnitude is at most 127, and a float at that magnitude has well over one
# fractional mantissa bit, making v + 0.5 (0.5 = 2^-1) exact and floorf(v + 0.5)
# equal to round((double) v). Negatives mirror through zero so the .5 boundary
# rounds away from zero (e.g. 2.5 -> 3, -2.5 -> -3), not toward even.
fn roundHA i32 v f32
  let half f32 0.5
  let zero f32 0.0
  if >= v zero
    let r f32 std.math.floorf (+ v half)
    ret (r as i32)
  let neg f32 - zero v
  let r2 f32 std.math.floorf (+ neg half)
  let ri i32 (r2 as i32)
  ret - 0 ri

# Quantized matmul: W (d, n) @ x (n,) -> out (d,), with both operands int8 and a
# shared group size gs. d = len(out), n = len(x.q); weights hold d*n quants
# (w.q) plus d*n/gs scales (w.s), activations hold n quants (x.q) plus n/gs
# scales (x.s). Each output is a dot product accumulated as an exact int32 sum
# of int8 products within a group, rescaled to f32 by that group's weight and
# activation scales, summed over groups — the byte-for-byte port of runq.c's
# matmul. The per-group accumulate-then-rescale and the left-to-right float
# multiply order ((ival * w_scale) * x_scale) are load-bearing for parity, as
# is resetting the integer accumulator each group. gs must divide n.
pub fn matmulQ Void out MutSpan<f32> x QActs w QWeight gs usize
  let xq MutSpan<i8> x.q
  let xs MutSpan<f32> x.s
  let wq Span<i8> w.q
  let ws Span<f32> w.s
  let d usize std.mem.len out
  let n usize std.mem.len xq
  mut i usize 0
  while < i d
    let row usize * i n
    mut val f32 0.0
    mut j usize 0
    while < j n
      mut ival i32 0
      mut k usize 0
      while < k gs
        let idx usize + row (+ j k)
        let jk usize + j k
        let xqv i32 (xq[jk] as i32)
        let wqv i32 (wq[idx] as i32)
        set ival + ival (* xqv wqv)
        set k + k 1
      let rowj usize + row j
      let wsi usize / rowj gs
      let xsi usize / j gs
      let wscale f32 ws[wsi]
      let xscale f32 xs[xsi]
      let ivalf f32 (ival as f32)
      set val + val (* (* ivalf wscale) xscale)
      set j + j gs
    set out[i] val
    set i + i 1

# Per-group symmetric activation quantizer (Q_MAX = 127), the port of runq.c's
# quantize. n = len(x); dst.q receives n int8 quants, dst.s receives n/gs f32
# group scales. For each group the scale is max(|x|) / 127 over the group, and
# each value is quantized to round(x / scale) (round half away from zero — see
# roundHA). No clamp is applied: |x / scale| <= 127 by construction, matching
# runq.c, which casts to int8 without clamping. gs must divide n.
pub fn quantizeActs Void dst QActs x Span<f32> gs usize
  let dq MutSpan<i8> dst.q
  let ds MutSpan<f32> dst.s
  let n usize std.mem.len x
  let q_max f32 127.0
  let num_groups usize / n gs
  mut g usize 0
  while < g num_groups
    let gbase usize * g gs
    mut wmax f32 0.0
    mut i usize 0
    while < i gs
      let xi usize + gbase i
      let xv f32 x[xi]
      let v f32 std.math.absf xv
      if > v wmax
        set wmax v
      set i + i 1
    # Matches runq.c exactly: a wmax==0 group yields scale 0 and a div-by-zero
    # (inf/NaN quants). Real activation groups never have an all-zero run, so
    # this path is unreachable in practice; left unguarded to preserve parity.
    let scale f32 / wmax q_max
    set ds[g] scale
    mut j usize 0
    while < j gs
      let xj usize + gbase j
      let q f32 / x[xj] scale
      let qi i32 roundHA q
      set dq[xj] (qi as i8)
      set j + j 1
    set g + g 1

# Dequantize a single weight row: out[i] = w.q[row*n + i] * w.s[(row*n + i) / gs]
# for i in 0..n. Used as the token-embedding gather — runq.c dequantizes the
# whole vocab*dim token table to f32 at load, but the only row needed per step
# is the embedded token's, so dequantizing on gather produces the same numbers
# without the large f32 buffer. The int8 quants are read directly from the
# signed Span<i8>. out holds n elements; gs must divide n.
pub fn dequantRow Void out MutSpan<f32> w QWeight row usize n usize gs usize
  let wq Span<i8> w.q
  let ws Span<f32> w.s
  let base usize * row n
  mut i usize 0
  while < i n
    let idx usize + base i
    let qv i32 (wq[idx] as i32)
    let qf f32 (qv as f32)
    let si usize / idx gs
    let scale f32 ws[si]
    set out[i] (* qf scale)
    set i + i 1
