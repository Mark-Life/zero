// llama2.zero — forward-pass math kernels.
//
// The five f32 forward-pass primitives, ported one-to-one from `llama2.c`:
// RMSNorm, matmul, softmax, RoPE, and the SwiGLU non-linearity. All are pure
// functions over `Span<f32>` / `MutSpan<f32>` — dimensions are read from the span
// lengths, so the caller (transformer.0) slices the right tensor view and the
// kernel needs no separate size arguments. Weights arrive as the zero-copy
// `Span<f32>` views built in checkpoint.0.
//
// Alongside them are three int8-quantized kernels (`matmulQ`, `quantizeActs`,
// `dequantRow`), ported one-to-one from `runq.c`, used by the quantized forward
// pass: a quantized matmul over int8 weights and int8 activations, a per-group
// symmetric activation quantizer, and a single-row weight dequantizer (the token
// embedding gather). They take an explicit group size `gs` because the
// quantization groups span the matmul inner dimension. The int8 math is integer
// up to a per-group f32 rescale, so it must reproduce `runq.c`'s operation order
// bit-for-bit (see the notes on each).
//
// Numerics track `llama2.c` / `runq.c` exactly (same operation order, libm via
// std.math), so a temperature-0 run reproduces the C token stream.

use checkpoint

// RMSNorm: output[j] = weights[j] * input[j] / sqrt(mean(input^2) + eps).
// Mirrors `rmsnorm(o, x, weight, size)` with `size` taken from `input`. `eps`
// is the reference's hardcoded 1e-5f, passed in so the caller owns the constant.
pub fun rmsnorm(output: MutSpan<f32>, input: Span<f32>, weights: Span<f32>, eps: f32) -> Void {
    let n: usize = std.mem.len(input)
    let mut ss: f32 = 0.0
    let mut i: usize = 0
    while i < n {
        let v: f32 = input[i]
        ss = ss + v * v
        i = i + 1
    }
    let nf: f32 = (n as i32) as f32
    ss = ss / nf
    ss = ss + eps
    let inv: f32 = 1.0 / std.math.sqrtf(ss)
    let mut j: usize = 0
    while j < n {
        output[j] = weights[j] * (inv * input[j])
        j = j + 1
    }
}

// matmul: W (d, n) @ x (n,) -> output (d,), row-major weights. `d` and `n` come
// from the output and input span lengths; `weights` must hold d*n elements. This
// is the forward pass's hot loop — `weights` is a plain `Span<f32>` view so each
// access is a bare load with one bounds check, no per-element fat-pointer math.
pub fun matmul(output: MutSpan<f32>, input: Span<f32>, weights: Span<f32>) -> Void {
    let d: usize = std.mem.len(output)
    let n: usize = std.mem.len(input)
    let mut i: usize = 0
    while i < d {
        let row: usize = i * n
        let mut val: f32 = 0.0
        let mut j: usize = 0
        while j < n {
            let idx: usize = row + j
            val = val + weights[idx] * input[j]
            j = j + 1
        }
        output[i] = val
        i = i + 1
    }
}

// softmax in place over `x`, with the standard max-subtraction for numerical
// stability. Mirrors `softmax(x, size)`; the attention path calls it on a
// `MutSpan<f32>` slice of the score buffer. Assumes a non-empty span (the
// reference reads x[0] unconditionally).
pub fun softmax(x: MutSpan<f32>) -> Void {
    let n: usize = std.mem.len(x)
    let mut maxv: f32 = x[0]
    let mut i: usize = 1
    while i < n {
        if x[i] > maxv {
            maxv = x[i]
        }
        i = i + 1
    }
    let mut sum: f32 = 0.0
    let mut j: usize = 0
    while j < n {
        let e: f32 = std.math.expf(x[j] - maxv)
        x[j] = e
        sum = sum + e
        j = j + 1
    }
    let mut k: usize = 0
    while k < n {
        x[k] = x[k] / sum
        k = k + 1
    }
}

// RoPE: rotate consecutive (even, odd) pairs of `vec` in place by the
// position-dependent angle. Mirrors the rotation `llama2.c` applies to q and k;
// call it once per vector — q has `dim` elements, k has `kv_dim`. Because the
// frequency depends only on `head_dim = idx % head_size`, rotating each vector
// over its own length reproduces the reference's `rotn` (q for all i, k only for
// i < kv_dim) exactly. `head_size` must be even.
pub fun rope(vec: MutSpan<f32>, pos: i32, head_size: usize) -> Void {
    let n: usize = std.mem.len(vec)
    let posf: f32 = pos as f32
    let hsf: f32 = (head_size as i32) as f32
    let base: f32 = 10000.0
    let mut i: usize = 0
    while i < n {
        let head_dim: usize = i % head_size
        let hd: f32 = (head_dim as i32) as f32
        let exponent: f32 = hd / hsf
        let denom: f32 = std.math.powf(base, exponent)
        let freq: f32 = 1.0 / denom
        let val: f32 = posf * freq
        let fcr: f32 = std.math.cosf(val)
        let fci: f32 = std.math.sinf(val)
        let i1: usize = i + 1
        let v0: f32 = vec[i]
        let v1: f32 = vec[i1]
        vec[i] = v0 * fcr - v1 * fci
        vec[i1] = v0 * fci + v1 * fcr
        i = i + 2
    }
}

// SwiGLU non-linearity in place: hb[i] = silu(hb[i]) * hb2[i], where
// silu(v) = v * sigmoid(v) = v / (1 + exp(-v)). Mirrors the FFN gate combine in
// `llama2.c` (hb holds w1(x), hb2 holds w3(x)).
pub fun swiglu(hb: MutSpan<f32>, hb2: Span<f32>) -> Void {
    let n: usize = std.mem.len(hb)
    let mut i: usize = 0
    while i < n {
        let v: f32 = hb[i]
        let negv: f32 = 0.0 - v
        let e: f32 = std.math.expf(negv)
        let denom: f32 = 1.0 + e
        let sig: f32 = 1.0 / denom
        let silu: f32 = v * sig
        let g: f32 = hb2[i]
        hb[i] = silu * g
        i = i + 1
    }
}

// Quantized-activation scratch, writable. Mirrors `runq.c`'s `QuantizedTensor`
// for the activation side: `q` holds the signed int8 quants as a `MutSpan<i8>`
// (one byte per value, matching runq.c's `int8_t*`), and `s` holds the f32 group
// scales (one per run of `group_size` quants). Filled by `quantizeActs` and
// consumed by `matmulQ`. Lives in the run state, so both fields are `MutSpan`.
pub shape QActs {
    q: MutSpan<i8>,
    s: MutSpan<f32>,
}

// Round half away from zero, matching C's `round()` — used by the activation
// quantizer because std.math has no `roundf`. For the quantizer's operating range
// this is exact: the argument is `x / scale` with `scale = max(|x|) / 127`, so its
// magnitude is at most 127, and a float at that magnitude has well over one
// fractional mantissa bit, making `v + 0.5` (0.5 = 2^-1) exact and `floorf(v +
// 0.5)` equal to `round((double) v)`. Negatives mirror through zero so the .5
// boundary rounds away from zero (e.g. 2.5 -> 3, -2.5 -> -3), not toward even.
fun roundHA(v: f32) -> i32 {
    let half: f32 = 0.5
    let zero: f32 = 0.0
    if v >= zero {
        let r: f32 = std.math.floorf(v + half)
        return r as i32
    }
    let neg: f32 = zero - v
    let r2: f32 = std.math.floorf(neg + half)
    let ri: i32 = r2 as i32
    return 0 - ri
}

// Quantized matmul: W (d, n) @ x (n,) -> out (d,), with both operands int8 and a
// shared group size `gs`. `d = len(out)`, `n = len(x.q)`; weights hold d*n quants
// (`w.q`) plus d*n/gs scales (`w.s`), activations hold n quants (`x.q`) plus n/gs
// scales (`x.s`). Each output is a dot product accumulated as an exact int32 sum
// of int8 products within a group, rescaled to f32 by that group's weight and
// activation scales, summed over groups — the byte-for-byte port of `runq.c`'s
// `matmul`. The per-group accumulate-then-rescale and the left-to-right float
// multiply order (`(ival * w_scale) * x_scale`) are load-bearing for parity, as
// is resetting the integer accumulator each group. `gs` must divide `n`.
pub fun matmulQ(out: MutSpan<f32>, x: QActs, w: QWeight, gs: usize) -> Void {
    let d: usize = std.mem.len(out)
    let n: usize = std.mem.len(x.q)
    let wq = w.q
    let ws = w.s
    let xq = x.q
    let xs = x.s
    let o = out
    let mut i: usize = 0
    while i < d {
        let row: usize = i * n
        let mut val: f32 = 0.0
        let mut j: usize = 0
        while j < n {
            let mut ival: i32 = 0
            let mut k: usize = 0
            while k < gs {
                let idx: usize = row + j + k
                let xqv: i32 = xq[j + k] as i32
                let wsv: i32 = wq[idx] as i32
                ival = ival + xqv * wsv
                k = k + 1
            }
            let wscale: f32 = ws[(row + j) / gs]
            let xscale: f32 = xs[j / gs]
            let ivalf: f32 = ival as f32
            val = val + (ivalf * wscale) * xscale
            j = j + gs
        }
        o[i] = val
        i = i + 1
    }
}

// Per-group symmetric activation quantizer (Q_MAX = 127), the port of `runq.c`'s
// `quantize`. `n = len(x)`; `dst.q` receives n int8 quants (as i32), `dst.s`
// receives n/gs f32 group scales. For each group the scale is `max(|x|) / 127`
// over the group, and each value is quantized to `round(x / scale)` (round half
// away from zero — see `roundHA`). No clamp is applied: `|x / scale| <= 127` by
// construction, matching `runq.c`, which casts to int8 without clamping. `gs` must
// divide `n`.
pub fun quantizeActs(dst: QActs, x: Span<f32>, gs: usize) -> Void {
    let n: usize = std.mem.len(x)
    let dq = dst.q
    let ds = dst.s
    let q_max: f32 = 127.0
    let num_groups: usize = n / gs
    let mut g: usize = 0
    while g < num_groups {
        let gbase: usize = g * gs
        let mut wmax: f32 = 0.0
        let mut i: usize = 0
        while i < gs {
            let v: f32 = std.math.absf(x[gbase + i])
            if v > wmax {
                wmax = v
            }
            i = i + 1
        }
        // Matches runq.c exactly: a wmax==0 group yields scale 0 and a div-by-zero
        // (inf/NaN quants). Real activation groups never have an all-zero run, so
        // this path is unreachable in practice; left unguarded to preserve parity.
        let scale: f32 = wmax / q_max
        ds[g] = scale
        let mut j: usize = 0
        while j < gs {
            let q: f32 = x[gbase + j] / scale
            dq[gbase + j] = roundHA(q) as i8
            j = j + 1
        }
        g = g + 1
    }
}

// Dequantize a single weight row: out[i] = w.q[row*n + i] * w.s[(row*n + i) / gs]
// for i in 0..n. Used as the token-embedding gather — `runq.c` dequantizes the
// whole vocab*dim token table to f32 at load, but the only row needed per step is
// the embedded token's, so dequantizing on gather produces the same numbers
// without the large f32 buffer. The int8 quants are read directly from the signed
// `Span<i8>`. `out` holds n elements; `gs` must divide `n`.
pub fun dequantRow(out: MutSpan<f32>, w: QWeight, row: usize, n: usize, gs: usize) -> Void {
    let wq = w.q
    let ws = w.s
    let o = out
    let base: usize = row * n
    let mut i: usize = 0
    while i < n {
        let idx: usize = base + i
        let qv: i32 = wq[idx] as i32
        let qf: f32 = qv as f32
        let scale: f32 = ws[idx / gs]
        o[i] = qf * scale
        i = i + 1
    }
}
