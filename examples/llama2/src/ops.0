// llama2.zero — forward-pass math kernels.
//
// The five forward-pass primitives, ported one-to-one from `llama2.c`: RMSNorm,
// matmul, softmax, RoPE, and the SwiGLU non-linearity. All are pure functions
// over `Span<f32>` / `MutSpan<f32>` — dimensions are read from the span lengths,
// so the caller (transformer.0) slices the right tensor view and the
// kernel needs no separate size arguments. Weights arrive as the zero-copy
// `Span<f32>` views built in checkpoint.0.
//
// Numerics track `llama2.c` exactly (same operation order, libm via std.math),
// so a temperature-0 run reproduces the C token stream within libm ULPs.

// RMSNorm: output[j] = weights[j] * input[j] / sqrt(mean(input^2) + eps).
// Mirrors `rmsnorm(o, x, weight, size)` with `size` taken from `input`. `eps`
// is the reference's hardcoded 1e-5f, passed in so the caller owns the constant.
pub fun rmsnorm(output: MutSpan<f32>, input: Span<f32>, weights: Span<f32>, eps: f32) -> Void {
    let n: usize = std.mem.len(input)
    let mut ss: f32 = 0.0
    let mut i: usize = 0
    while i < n {
        let v: f32 = input[i]
        ss = ss + v * v
        i = i + 1
    }
    let nf: f32 = (n as i32) as f32
    ss = ss / nf
    ss = ss + eps
    let inv: f32 = 1.0 / std.math.sqrtf(ss)
    let mut j: usize = 0
    while j < n {
        output[j] = weights[j] * (inv * input[j])
        j = j + 1
    }
}

// matmul: W (d, n) @ x (n,) -> output (d,), row-major weights. `d` and `n` come
// from the output and input span lengths; `weights` must hold d*n elements. This
// is the forward pass's hot loop — `weights` is a plain `Span<f32>` view so each
// access is a bare load with one bounds check, no per-element fat-pointer math.
pub fun matmul(output: MutSpan<f32>, input: Span<f32>, weights: Span<f32>) -> Void {
    let d: usize = std.mem.len(output)
    let n: usize = std.mem.len(input)
    let mut i: usize = 0
    while i < d {
        let row: usize = i * n
        let mut val: f32 = 0.0
        let mut j: usize = 0
        while j < n {
            let idx: usize = row + j
            val = val + weights[idx] * input[j]
            j = j + 1
        }
        output[i] = val
        i = i + 1
    }
}

// softmax in place over `x`, with the standard max-subtraction for numerical
// stability. Mirrors `softmax(x, size)`; the attention path calls it on a
// `MutSpan<f32>` slice of the score buffer. Assumes a non-empty span (the
// reference reads x[0] unconditionally).
pub fun softmax(x: MutSpan<f32>) -> Void {
    let n: usize = std.mem.len(x)
    let mut maxv: f32 = x[0]
    let mut i: usize = 1
    while i < n {
        if x[i] > maxv {
            maxv = x[i]
        }
        i = i + 1
    }
    let mut sum: f32 = 0.0
    let mut j: usize = 0
    while j < n {
        let e: f32 = std.math.expf(x[j] - maxv)
        x[j] = e
        sum = sum + e
        j = j + 1
    }
    let mut k: usize = 0
    while k < n {
        x[k] = x[k] / sum
        k = k + 1
    }
}

// RoPE: rotate consecutive (even, odd) pairs of `vec` in place by the
// position-dependent angle. Mirrors the rotation `llama2.c` applies to q and k;
// call it once per vector — q has `dim` elements, k has `kv_dim`. Because the
// frequency depends only on `head_dim = idx % head_size`, rotating each vector
// over its own length reproduces the reference's `rotn` (q for all i, k only for
// i < kv_dim) exactly. `head_size` must be even.
pub fun rope(vec: MutSpan<f32>, pos: i32, head_size: usize) -> Void {
    let n: usize = std.mem.len(vec)
    let posf: f32 = pos as f32
    let hsf: f32 = (head_size as i32) as f32
    let base: f32 = 10000.0
    let mut i: usize = 0
    while i < n {
        let head_dim: usize = i % head_size
        let hd: f32 = (head_dim as i32) as f32
        let exponent: f32 = hd / hsf
        let denom: f32 = std.math.powf(base, exponent)
        let freq: f32 = 1.0 / denom
        let val: f32 = posf * freq
        let fcr: f32 = std.math.cosf(val)
        let fci: f32 = std.math.sinf(val)
        let i1: usize = i + 1
        let v0: f32 = vec[i]
        let v1: f32 = vec[i1]
        vec[i] = v0 * fcr - v1 * fci
        vec[i1] = v0 * fci + v1 * fcr
        i = i + 2
    }
}

// SwiGLU non-linearity in place: hb[i] = silu(hb[i]) * hb2[i], where
// silu(v) = v * sigmoid(v) = v / (1 + exp(-v)). Mirrors the FFN gate combine in
// `llama2.c` (hb holds w1(x), hb2 holds w3(x)).
pub fun swiglu(hb: MutSpan<f32>, hb2: Span<f32>) -> Void {
    let n: usize = std.mem.len(hb)
    let mut i: usize = 0
    while i < n {
        let v: f32 = hb[i]
        let negv: f32 = 0.0 - v
        let e: f32 = std.math.expf(negv)
        let denom: f32 = 1.0 + e
        let sig: f32 = 1.0 / denom
        let silu: f32 = v * sig
        let g: f32 = hb2[i]
        hb[i] = silu * g
        i = i + 1
    }
}
