# llama2.zero — generation loop.
#
# Loads the checkpoint + tokenizer, BPE-encodes the prompt, then runs the
# autoregressive generation loop, ported from `llama2.c` `generate`: forward the
# transformer at the current position, force the next prompt token while still
# inside the prompt or otherwise sample from the logits, stream the decoded
# piece to stdout, and feed the chosen token back in. The loop ends at `--tokens`
# steps (clamped to seq_len) or when a BOS (=1) delimiter is produced.
#
# The on-disk format is auto-detected by magic number: a v2 quantized ("ak42")
# checkpoint takes the int8 path (`forwardQ`), anything else the legacy f32 path
# (`forward`). The tokenizer + sampler setup is shared between the two; only the
# weights, run state, and forward call are format-specific.
#
# Numeric flags are parsed at runtime here — `std.parse` folds only string
# literals at compile time, so `--tokens` uses a hand-rolled `parseUsize` (the
# int analog of `parseF32`, which parses `--temperature` in sampler.0).

use checkpoint
use transformer
use tokenizer
use sampler

# True when every byte of `bytes` is an ASCII digit (and `bytes` is non-empty).
# Validates `--tokens` before `parseUsize`, so a bad value reports an error
# rather than silently parsing to a partial number.
fn allDigits Bool bytes Span<u8>
  let n usize std.mem.len bytes
  if == n 0
    ret false
  let lo u8 ('0' as u8)
  let hi u8 ('9' as u8)
  mut ok Bool true
  mut i usize 0
  while < i n
    let c u8 bytes[i]
    let below Bool (< c lo)
    let above Bool (> c hi)
    if || below above
      set ok false
    set i + i 1
  ret ok

# Parse a non-negative decimal integer from its byte span. The runtime `--tokens`
# value needs this because `std.parse` is compile-time only; non-digit bytes are
# skipped (the value is `allDigits`-validated first). Overflow wraps with the
# backend's u64 arithmetic — token budgets are tiny, so this never matters.
fn parseUsize usize s Span<u8>
  let n usize std.mem.len s
  let zeroc u8 ('0' as u8)
  let ninec u8 ('9' as u8)
  mut value usize 0
  mut i usize 0
  while < i n
    let c u8 s[i]
    let below Bool (< c zeroc)
    let above Bool (> c ninec)
    let bad Bool (|| below above)
    if == bad false
      let d i32 - (c as i32) (zeroc as i32)
      let du usize (d as usize)
      set value + (* value 10) du
    set i + i 1
  ret value

# Mirrors `llama2.c` `safe_printf`: a decoded piece is emitted as-is unless it is
# a single byte that is neither printable (0x20..0x7E) nor whitespace
# (0x09..0x0D), in which case it is dropped. This keeps the raw-byte `<0xNN>`
# fallback path from streaming control bytes that C silently suppresses.
# Multi-byte pieces (and the empty piece) always pass through.
fn isSafePiece Bool piece Span<u8>
  let n usize std.mem.len piece
  if == n 1
    let b u8 piece[0]
    let printable Bool (&& (>= b (32 as u8)) (<= b (126 as u8)))
    let tabFf Bool (&& (>= b (9 as u8)) (<= b (13 as u8)))
    ret (|| printable tabFf)
  ret true

pub fn main Void world World !
  let argc usize std.args.len()
  let model_arg Maybe<String> std.args.get 1
  let no_model Bool (|| (< argc 2) (== model_arg.has false))
  if no_model
    check world.err.write "usage: llama2 <model.bin> --prompt <text> --tokens <n> [--temperature <t>] [--topp <p>] [--topk <k>]\n"
    ret
  let model String model_arg.value

  mut prompt String ""
  mut tokens_arg String "256"
  mut temperature String "1.0"
  mut tokenizer_path String "tokenizer.bin"
  # top-p / top-k default to 0 (disabled) — plain multinomial sampling, the
  # configuration the temperature-only parity tests cover.
  mut topp_arg String "0"
  mut topk_arg String "0"

  # Minimal flag scan: advance one arg at a time, match a known flag, and read
  # the following arg as its value. Values are assumed not to collide with flag
  # names.
  mut i usize 2
  while < i argc
    let flag Maybe<String> std.args.get i
    if flag.has
      let f String flag.value
      if std.mem.eql f "--prompt"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set prompt v.value
      if std.mem.eql f "--tokens"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set tokens_arg v.value
      if std.mem.eql f "--temperature"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set temperature v.value
      if std.mem.eql f "--topp"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set topp_arg v.value
      if std.mem.eql f "--topk"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set topk_arg v.value
      if std.mem.eql f "--tokenizer"
        let v Maybe<String> std.args.get (+ i 1)
        if v.has
          set tokenizer_path v.value
    set i + i 1

  # Validate the runtime --tokens value digit-by-digit over its byte span
  # (std.parse.* is compile-time only).
  let tokens_bytes Span<u8> std.mem.span tokens_arg
  let tokens_ok Bool allDigits tokens_bytes
  if == tokens_ok false
    check world.err.write "error: --tokens must be a non-negative integer\n"
    ret

  # `--topk` is an integer flag, validated the same way as `--tokens`.
  let topk_bytes Span<u8> std.mem.span topk_arg
  let topk_ok Bool allDigits topk_bytes
  if == topk_ok false
    check world.err.write "error: --topk must be a non-negative integer\n"
    ret

  # mmap the checkpoint, parse its header into a Config, validate the file
  # length against the header, and build the zero-copy weight views.
  let fs Fs std.fs.host()
  let mapped Maybe<owned<Mapping>> std.fs.mmap fs model
  if == mapped.has false
    check world.err.write "error: cannot open model file\n"
    ret
  mut m owned<Mapping> mapped.value
  let bytes Span<u8> std.fs.mappingBytes (&m)
  let hdr_len usize std.mem.len bytes
  if < hdr_len 28
    check world.err.write "error: model file too small for a checkpoint header\n"
    std.fs.munmap (&mut m)
    ret

  # Auto-detect the on-disk format by magic number: a v2 quantized ("ak42")
  # checkpoint takes the int8 path, anything else the legacy f32 path. The
  # header parse differs, but both yield the same `Config` shape, so the
  # tokenizer / sampler setup below (which needs only `cfg`) is shared; the
  # weights, run state, and forward call are format-specific and branch later.
  # `gs` (the quantization group size) is only meaningful on the quantized path.
  let quantized Bool isQuantizedV2 bytes
  mut cfg Config readConfig bytes
  mut gs usize 0
  if quantized
    set cfg readConfigV2 bytes
    set gs groupSize bytes

  # mmap the tokenizer and BPE-encode the prompt. The mapping stays live for
  # the whole run because `decode` returns views into it — it is unmapped after
  # the generation loop, not here.
  let tok_mapped Maybe<owned<Mapping>> std.fs.mmap fs tokenizer_path
  if == tok_mapped.has false
    check world.err.write "error: cannot open tokenizer file\n"
    std.fs.munmap (&mut m)
    ret
  mut tm owned<Mapping> tok_mapped.value
  let tok_bytes Span<u8> std.fs.mappingBytes (&tm)

  # One combined vocab-index region for O(log vocab) tokenizer
  # lookup — `2 * vocab` i32s, sliced inside buildTokenizer into an entry-offset
  # table (O(1) random access) and a string-sorted id list (binary search).
  # Allocated once here (anonymous mmap, like RunState) and filled + sorted by
  # buildTokenizer. One region (not two) keeps the record-returning call within
  # the direct backend's five-integer-argument cap.
  let vocab_idx usize (cfg.vocab_size as usize)
  let idx_count usize * vocab_idx 2
  let idx_bytes_need usize * idx_count 4
  let idx_heap PageAlloc std.mem.pageAlloc()
  let idx_region Maybe<MutSpan<u8>> std.mem.allocBytes idx_heap idx_bytes_need
  if == idx_region.has false
    check world.err.write "error: cannot allocate tokenizer index\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let idx_base MutSpan<u8> idx_region.value
  let tok_idx MutSpan<i32> std.mem.bytesAsMutI32 idx_base

  let tk Tokenizer buildTokenizer tok_bytes tok_idx
  let prompt_bytes Span<u8> std.mem.span prompt
  let prompt_len usize std.mem.len prompt_bytes
  let prompt_need usize + prompt_len 3
  let seq_cap usize (cfg.seq_len as usize)
  if > prompt_need seq_cap
    check world.err.write "error: prompt too long for this model's context window\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let pt_bytes_need usize * seq_cap 4
  let pt_heap PageAlloc std.mem.pageAlloc()
  let pt_region Maybe<MutSpan<u8>> std.mem.allocBytes pt_heap pt_bytes_need
  if == pt_region.has false
    check world.err.write "error: cannot allocate prompt token buffer\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let pt_base MutSpan<u8> pt_region.value
  let pt MutSpan<i32> std.mem.bytesAsMutI32 pt_base
  let n_prompt usize encode tk prompt_bytes pt true
  if < n_prompt 1
    check world.err.write "error: prompt encoded to zero tokens\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret

  # Parse the numeric flags. `--tokens` 0 (or over seq_len) clamps to seq_len,
  # matching `llama2.c`'s `steps` clamp.
  let temp_bytes Span<u8> std.mem.span temperature
  let temp f32 parseF32 temp_bytes
  # top-p is a float in (0,1); top-k a positive integer (allDigits-validated
  # above). top-p is parsed leniently like --temperature (std.parse is
  # compile-time only); both default to 0 (off).
  let topp_bytes Span<u8> std.mem.span topp_arg
  let topp f32 parseF32 topp_bytes
  let topk_usize usize parseUsize topk_bytes
  let topk i32 (topk_usize as i32)
  mut steps usize parseUsize tokens_bytes
  let seq_len_u usize (cfg.seq_len as usize)
  if == steps 0
    set steps seq_len_u
  if > steps seq_len_u
    set steps seq_len_u

  # One-byte scratch the tokenizer writes raw-byte `<0xNN>` fallback tokens into,
  # so `decode` can return a span that outlives the call (page stays mapped for
  # the whole run).
  let dec_heap PageAlloc std.mem.pageAlloc()
  let dec_region Maybe<MutSpan<u8>> std.mem.allocBytes dec_heap 4096
  if == dec_region.has false
    check world.err.write "error: cannot allocate decode scratch\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let dec_scratch MutSpan<u8> dec_region.value

  # Two vocab-sized scratch regions the top-p / top-k paths sort over: a prob
  # copy (f32) and the parallel original-index array (i32). Allocated once and
  # reused per token (like RunState), then bundled into the Sampler. Built here
  # in straight-line position so the loop passes a plain record local (a record
  # literal as a call arg is not allowed inside the loop).
  let vocab_u usize (cfg.vocab_size as usize)
  let sp_need usize * vocab_u 4
  let sp_heap PageAlloc std.mem.pageAlloc()
  let sp_region Maybe<MutSpan<u8>> std.mem.allocBytes sp_heap sp_need
  if == sp_region.has false
    check world.err.write "error: cannot allocate sampler prob scratch\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let sp_base MutSpan<u8> sp_region.value
  let prob_scratch MutSpan<f32> std.mem.bytesAsMutF32 sp_base

  let ix_heap PageAlloc std.mem.pageAlloc()
  let ix_region Maybe<MutSpan<u8>> std.mem.allocBytes ix_heap sp_need
  if == ix_region.has false
    check world.err.write "error: cannot allocate sampler index scratch\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let ix_base MutSpan<u8> ix_region.value
  let index_scratch MutSpan<i32> std.mem.bytesAsMutI32 ix_base

  let sampler Sampler . prob prob_scratch index index_scratch temperature temp topp topp topk topk

  # Auto-detected v2 (int8) quantized path. Validate the file byte length against
  # the v2 header, build the quantized weight description, and size the run state
  # with the extra quantized-activation scratch. Mirrors the f32 path below; the
  # only difference is mapWeightsQ + mallocRunStateQ + forwardQ.
  if quantized
    let expected_q usize expectedFileBytesQ cfg gs
    let actual_q usize std.mem.len bytes
    if != expected_q actual_q
      check world.err.write "error: checkpoint size does not match its header\n"
      std.fs.munmap (&mut tm)
      std.fs.munmap (&mut m)
      ret
    let qw QuantizedWeights mapWeightsQ bytes cfg gs

    let rs_floats_q usize runStateFloatsQ cfg gs
    let rs_bytes_q usize * rs_floats_q 4
    let heap_q PageAlloc std.mem.pageAlloc()
    let rs_region_q Maybe<MutSpan<u8>> std.mem.allocBytes heap_q rs_bytes_q
    if == rs_region_q.has false
      check world.err.write "error: cannot allocate run state\n"
      std.fs.munmap (&mut tm)
      std.fs.munmap (&mut m)
      ret
    let rs_base_q MutSpan<u8> rs_region_q.value
    let state_q RunState mallocRunStateQ rs_base_q cfg gs

    # Generation loop — mirrors the f32 loop below exactly, calling forwardQ in
    # place of forward.
    mut rng_q u64 12345
    mut token_q i32 pt[0]
    mut pos_q usize 0
    while < pos_q steps
      forwardQ cfg qw state_q token_q (pos_q as i32)
      let step_logits_q MutSpan<f32> logitsOf state_q cfg

      mut next_q i32 0
      let in_prompt_q Bool (< (+ pos_q 1) n_prompt)
      if in_prompt_q
        set next_q pt[(+ pos_q 1)]
      if == in_prompt_q false
        set rng_q rngNext rng_q
        let coin_q f32 randomF32 rng_q
        set next_q sample sampler step_logits_q coin_q
      set pos_q + pos_q 1

      let stop_q Bool (== next_q 1)
      if stop_q
        set pos_q steps
      if == stop_q false
        let piece_q Span<u8> decode tk token_q next_q dec_scratch
        if isSafePiece piece_q
          check world.out.write piece_q
        set token_q next_q
    check world.out.write "\n"

    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret

  # Legacy f32 path. Validate the file length against the header and build the
  # zero-copy weight views.
  let expected usize expectedFileFloats cfg
  let actual usize / hdr_len 4
  let size_ok Bool (== expected actual)
  if == size_ok false
    check world.err.write "error: checkpoint size does not match its header\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let weights TransformerWeights mapWeights bytes cfg

  # Allocate the zeroed RunState region (anonymous mmap, sized from Config) once
  # — the KV cache persists across positions for the whole generation.
  let rs_floats usize runStateFloats cfg
  let rs_bytes usize * rs_floats 4
  let heap PageAlloc std.mem.pageAlloc()
  let rs_region Maybe<MutSpan<u8>> std.mem.allocBytes heap rs_bytes
  if == rs_region.has false
    check world.err.write "error: cannot allocate run state\n"
    std.fs.munmap (&mut tm)
    std.fs.munmap (&mut m)
    ret
  let rs_base MutSpan<u8> rs_region.value
  let state RunState mallocRunState rs_base cfg

  # Autoregressive generation loop (llama2.c `generate`). A fixed PRNG seed
  # keeps temperature>0 runs reproducible; temperature 0 (argmax) ignores it.
  mut rng u64 12345
  mut token i32 pt[0]
  mut pos usize 0
  while < pos steps
    forward cfg weights state token (pos as i32)
    let step_logits MutSpan<f32> logitsOf state cfg

    # While still inside the prompt, force the next prompt token; afterwards
    # sample (drawing one coin per token, as llama2.c does for temperature>0).
    mut next i32 0
    let in_prompt Bool (< (+ pos 1) n_prompt)
    if in_prompt
      set next pt[(+ pos 1)]
    if == in_prompt false
      set rng rngNext rng
      let coin f32 randomF32 rng
      set next sample sampler step_logits coin
    set pos + pos 1

    # The BOS (=1) token delimits sequences — stop before emitting it. The
    # direct backend has no `break`, so end the loop by jumping `pos` to the
    # bound and guard the emit instead.
    let stop Bool (== next 1)
    if stop
      set pos steps
    if == stop false
      # Stream the decoded piece (a view into the live tokenizer mapping,
      # or the decode scratch for a raw-byte `<0xNN>` fallback token).
      let piece Span<u8> decode tk token next dec_scratch
      if isSafePiece piece
        check world.out.write piece
      set token next
  check world.out.write "\n"

  std.fs.munmap (&mut tm)
  std.fs.munmap (&mut m)
  ret
