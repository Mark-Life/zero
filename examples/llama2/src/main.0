// llama2.zero — generation loop.
//
// Loads the checkpoint + tokenizer, BPE-encodes the prompt, then runs the
// autoregressive generation loop, ported from `llama2.c` `generate`: forward the
// transformer at the current position, force the next prompt token while still
// inside the prompt or otherwise sample from the logits, stream the decoded
// piece to stdout, and feed the chosen token back in. The loop ends at `--tokens`
// steps (clamped to seq_len) or when a BOS (=1) delimiter is produced.
//
// Numeric flags are parsed at runtime here — `std.parse` folds only string
// literals at compile time, so `--tokens` uses a hand-rolled `parseUsize` (the
// int analog of `parseF32`, which parses `--temperature` in sampler.0).

use checkpoint
use transformer
use tokenizer
use sampler

// True when every byte of `bytes` is an ASCII digit (and `bytes` is non-empty).
// Validates `--tokens` before `parseUsize`, so a bad value reports an error
// rather than silently parsing to a partial number.
fun allDigits(bytes: Span<u8>) -> Bool {
    let n = std.mem.len(bytes)
    if n == 0 {
        return false
    }
    let lo = ('0' as u8)
    let hi = ('9' as u8)
    let mut ok = true
    let mut i: usize = 0
    while i < n {
        let c = bytes[i]
        let below = c < lo
        let above = c > hi
        if below || above {
            ok = false
        }
        i = i + 1
    }
    return ok
}

// Parse a non-negative decimal integer from its byte span. The runtime `--tokens`
// value needs this because `std.parse` is compile-time only; non-digit bytes are
// skipped (the value is `allDigits`-validated first). Overflow wraps with the
// backend's u64 arithmetic — token budgets are tiny, so this never matters.
fun parseUsize(s: Span<u8>) -> usize {
    let n = std.mem.len(s)
    let zeroc = '0' as u8
    let ninec = '9' as u8
    let mut value: usize = 0
    let mut i: usize = 0
    while i < n {
        let c = s[i]
        let below = c < zeroc
        let above = c > ninec
        let bad = below || above
        if bad == false {
            let d = (c as i32) - (zeroc as i32)
            let du = d as usize
            value = value * 10 + du
        }
        i = i + 1
    }
    return value
}

pub fun main(world: World) -> Void raises {
    let argc = std.args.len()
    let model_arg = std.args.get(1)
    if argc < 2 || model_arg.has == false {
        check world.err.write("usage: llama2 <model.bin> --prompt <text> --tokens <n> [--temperature <t>] [--topp <p>] [--topk <k>]\n")
        return
    }
    let model = model_arg.value

    let mut prompt: String = ""
    let mut tokens_arg: String = "256"
    let mut temperature: String = "1.0"
    let mut tokenizer_path: String = "tokenizer.bin"
    // top-p / top-k default to 0 (disabled) — plain multinomial sampling, the
    // configuration the temperature-only parity tests cover.
    let mut topp_arg: String = "0"
    let mut topk_arg: String = "0"

    // Minimal flag scan: advance one arg at a time, match a known flag, and read
    // the following arg as its value. Values are assumed not to collide with flag
    // names.
    let mut i: usize = 2
    while i < argc {
        let flag = std.args.get(i)
        if flag.has {
            let f = flag.value
            if std.mem.eql(f, "--prompt") {
                let v = std.args.get(i + 1)
                if v.has {
                    prompt = v.value
                }
            }
            if std.mem.eql(f, "--tokens") {
                let v = std.args.get(i + 1)
                if v.has {
                    tokens_arg = v.value
                }
            }
            if std.mem.eql(f, "--temperature") {
                let v = std.args.get(i + 1)
                if v.has {
                    temperature = v.value
                }
            }
            if std.mem.eql(f, "--topp") {
                let v = std.args.get(i + 1)
                if v.has {
                    topp_arg = v.value
                }
            }
            if std.mem.eql(f, "--topk") {
                let v = std.args.get(i + 1)
                if v.has {
                    topk_arg = v.value
                }
            }
            if std.mem.eql(f, "--tokenizer") {
                let v = std.args.get(i + 1)
                if v.has {
                    tokenizer_path = v.value
                }
            }
        }
        i = i + 1
    }

    // Validate the runtime --tokens value digit-by-digit over its byte span
    // (std.parse.* is compile-time only).
    let tokens_bytes = std.mem.span(tokens_arg)
    if allDigits(tokens_bytes) == false {
        check world.err.write("error: --tokens must be a non-negative integer\n")
        return
    }

    // mmap the checkpoint, parse its header into a Config, validate the file
    // length against the header, and build the zero-copy weight views.
    let fs = std.fs.host()
    let mapped = std.fs.mmap(fs, model)
    if mapped.has == false {
        check world.err.write("error: cannot open model file\n")
        return
    }
    let mut m: owned<Mapping> = mapped.value
    let bytes = std.fs.mappingBytes(&m)
    if std.mem.len(bytes) < 28 {
        check world.err.write("error: model file too small for a checkpoint header\n")
        std.fs.munmap(&mut m)
        return
    }

    // Auto-detect the on-disk format by magic number: a v2 quantized ("ak42")
    // checkpoint takes the int8 path, anything else the legacy f32 path. The
    // header parse differs, but both yield the same `Config` shape, so the
    // tokenizer / sampler setup below (which needs only `cfg`) is shared; the
    // weights, run state, and forward call are format-specific and branch later.
    // `gs` (the quantization group size) is only meaningful on the quantized path.
    let quantized = isQuantizedV2(bytes)
    let mut cfg = readConfig(bytes)
    let mut gs: usize = 0
    if quantized {
        cfg = readConfigV2(bytes)
        gs = groupSize(bytes)
    }

    // mmap the tokenizer and BPE-encode the prompt. The mapping stays live for
    // the whole run because `decode` returns views into it — it is unmapped after
    // the generation loop, not here.
    let tok_mapped = std.fs.mmap(fs, tokenizer_path)
    if tok_mapped.has == false {
        check world.err.write("error: cannot open tokenizer file\n")
        std.fs.munmap(&mut m)
        return
    }
    let mut tm: owned<Mapping> = tok_mapped.value
    let tok_bytes = std.fs.mappingBytes(&tm)

    // One combined vocab-index region for O(log vocab) tokenizer
    // lookup — `2 * vocab` i32s, sliced inside buildTokenizer into an entry-offset
    // table (O(1) random access) and a string-sorted id list (binary search).
    // Allocated once here (anonymous mmap, like RunState) and filled + sorted by
    // buildTokenizer. One region (not two) keeps the record-returning call within
    // the direct backend's five-integer-argument cap.
    let vocab_idx = cfg.vocab_size as usize
    let idx_count = vocab_idx * 2
    let idx_bytes_need = idx_count * 4
    let idx_heap = std.mem.pageAlloc()
    let idx_region = std.mem.allocBytes(idx_heap, idx_bytes_need)
    if idx_region.has == false {
        check world.err.write("error: cannot allocate tokenizer index\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let idx_base: MutSpan<u8> = idx_region.value
    let tok_idx: MutSpan<i32> = std.mem.bytesAsMutI32(idx_base)

    let tk = buildTokenizer(tok_bytes, tok_idx)
    let prompt_bytes = std.mem.span(prompt)
    let prompt_need = std.mem.len(prompt_bytes) + 3
    let seq_cap = cfg.seq_len as usize
    if prompt_need > seq_cap {
        check world.err.write("error: prompt too long for this model's context window\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let pt_bytes_need = seq_cap * 4
    let pt_heap = std.mem.pageAlloc()
    let pt_region = std.mem.allocBytes(pt_heap, pt_bytes_need)
    if pt_region.has == false {
        check world.err.write("error: cannot allocate prompt token buffer\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let pt_base: MutSpan<u8> = pt_region.value
    let pt: MutSpan<i32> = std.mem.bytesAsMutI32(pt_base)
    let n_prompt = encode(tk, prompt_bytes, pt, true)
    if n_prompt < 1 {
        check world.err.write("error: prompt encoded to zero tokens\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }

    // Parse the numeric flags. `--tokens` 0 (or over seq_len) clamps to seq_len,
    // matching `llama2.c`'s `steps` clamp.
    let temp_bytes = std.mem.span(temperature)
    let temp = parseF32(temp_bytes)
    // top-p is a float in (0,1); top-k a positive integer. Both default to 0
    // (off). Parsed leniently like --temperature (std.parse is compile-time only).
    let topp_bytes = std.mem.span(topp_arg)
    let topp = parseF32(topp_bytes)
    let topk_bytes = std.mem.span(topk_arg)
    let topk_usize = parseUsize(topk_bytes)
    let topk = topk_usize as i32
    let mut steps = parseUsize(tokens_bytes)
    let seq_len_u = cfg.seq_len as usize
    if steps == 0 {
        steps = seq_len_u
    }
    if steps > seq_len_u {
        steps = seq_len_u
    }

    // One-byte scratch the tokenizer writes raw-byte `<0xNN>` fallback tokens into,
    // so `decode` can return a span that outlives the call (page stays mapped for
    // the whole run).
    let dec_heap = std.mem.pageAlloc()
    let dec_region = std.mem.allocBytes(dec_heap, 4096)
    if dec_region.has == false {
        check world.err.write("error: cannot allocate decode scratch\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let dec_scratch: MutSpan<u8> = dec_region.value

    // Two vocab-sized scratch regions the top-p / top-k paths sort over: a prob
    // copy (f32) and the parallel original-index array (i32). Allocated once and
    // reused per token (like RunState), then bundled into the Sampler. Built here
    // in straight-line position so the loop passes a plain record local (a record
    // literal as a call arg is not allowed inside the loop).
    let vocab_u = cfg.vocab_size as usize
    let sp_need = vocab_u * 4
    let sp_heap = std.mem.pageAlloc()
    let sp_region = std.mem.allocBytes(sp_heap, sp_need)
    if sp_region.has == false {
        check world.err.write("error: cannot allocate sampler prob scratch\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let sp_base: MutSpan<u8> = sp_region.value
    let prob_scratch: MutSpan<f32> = std.mem.bytesAsMutF32(sp_base)

    let ix_heap = std.mem.pageAlloc()
    let ix_region = std.mem.allocBytes(ix_heap, sp_need)
    if ix_region.has == false {
        check world.err.write("error: cannot allocate sampler index scratch\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let ix_base: MutSpan<u8> = ix_region.value
    let index_scratch: MutSpan<i32> = std.mem.bytesAsMutI32(ix_base)

    let sampler = Sampler {
        prob: prob_scratch,
        index: index_scratch,
        temperature: temp,
        topp: topp,
        topk: topk
    }

    // Weights, run state, and the generation loop are format-specific (different
    // weight type + `forward` vs `forwardQ`), so they branch on the detected
    // format. Everything above — tokenizer, prompt encoding, flags, sampler — is
    // shared. The two loops below are identical apart from the single forward call;
    // the quantized one mirrors the f32 one with `forwardQ`.
    if quantized {
        // Quantized (int8) path. Validate the file byte length against the v2
        // header, build the quantized weight description, and size the run state
        // with the extra quantized-activation scratch.
        let expected_q = expectedFileBytesQ(cfg, gs)
        let actual_q = std.mem.len(bytes)
        if expected_q != actual_q {
            check world.err.write("error: checkpoint size does not match its header\n")
            std.fs.munmap(&mut tm)
            std.fs.munmap(&mut m)
            return
        }
        let qw = mapWeightsQ(bytes, cfg, gs)

        let rs_floats_q = runStateFloatsQ(cfg, gs)
        let rs_bytes_q = rs_floats_q * 4
        let heap_q = std.mem.pageAlloc()
        let rs_region_q = std.mem.allocBytes(heap_q, rs_bytes_q)
        if rs_region_q.has == false {
            check world.err.write("error: cannot allocate run state\n")
            std.fs.munmap(&mut tm)
            std.fs.munmap(&mut m)
            return
        }
        let rs_base_q: MutSpan<u8> = rs_region_q.value
        let state_q = mallocRunStateQ(rs_base_q, cfg, gs)

        // Autoregressive generation loop — mirrors the f32 loop below exactly,
        // calling `forwardQ` (int8 matmuls) in place of `forward`.
        let mut rng_q: u64 = 12345
        let mut token_q: i32 = pt[0]
        let mut pos_q: usize = 0
        while pos_q < steps {
            forwardQ(cfg, qw, state_q, token_q, pos_q as i32)
            let step_logits_q = logitsOf(state_q, cfg)

            let mut next_q: i32 = 0
            let in_prompt_q = pos_q + 1 < n_prompt
            if in_prompt_q {
                next_q = pt[pos_q + 1]
            }
            if in_prompt_q == false {
                rng_q = rngNext(rng_q)
                let coin_q = randomF32(rng_q)
                next_q = sample(sampler, step_logits_q, coin_q)
            }
            pos_q = pos_q + 1

            let stop_q = next_q == 1
            if stop_q {
                pos_q = steps
            }
            if stop_q == false {
                let piece_q = decode(tk, token_q, next_q, dec_scratch)
                check world.out.write(piece_q)
                token_q = next_q
            }
        }
        check world.out.write("\n")

        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }

    // Legacy f32 path. Validate the file length against the header and build the
    // zero-copy weight views.
    let expected = expectedFileFloats(cfg)
    let actual = std.mem.len(bytes) / 4
    let size_ok = expected == actual
    if size_ok == false {
        check world.err.write("error: checkpoint size does not match its header\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let weights = mapWeights(bytes, cfg)

    // Allocate the zeroed RunState region (anonymous mmap, sized from Config) once
    // — the KV cache persists across positions for the whole generation.
    let rs_floats = runStateFloats(cfg)
    let rs_bytes = rs_floats * 4
    let heap = std.mem.pageAlloc()
    let rs_region = std.mem.allocBytes(heap, rs_bytes)
    if rs_region.has == false {
        check world.err.write("error: cannot allocate run state\n")
        std.fs.munmap(&mut tm)
        std.fs.munmap(&mut m)
        return
    }
    let rs_base: MutSpan<u8> = rs_region.value
    let state = mallocRunState(rs_base, cfg)

    // Autoregressive generation loop (llama2.c `generate`). A fixed PRNG seed
    // keeps temperature>0 runs reproducible; temperature 0 (argmax) ignores it.
    let mut rng: u64 = 12345
    let mut token: i32 = pt[0]
    let mut pos: usize = 0
    while pos < steps {
        forward(cfg, weights, state, token, pos as i32)
        let step_logits = logitsOf(state, cfg)

        // While still inside the prompt, force the next prompt token; afterwards
        // sample (drawing one coin per token, as llama2.c does for temperature>0).
        let mut next: i32 = 0
        let in_prompt = pos + 1 < n_prompt
        if in_prompt {
            next = pt[pos + 1]
        }
        if in_prompt == false {
            rng = rngNext(rng)
            let coin = randomF32(rng)
            next = sample(sampler, step_logits, coin)
        }
        pos = pos + 1

        // The BOS (=1) token delimits sequences — stop before emitting it. The
        // direct backend has no `break`, so end the loop by jumping `pos` to the
        // bound and guard the emit instead.
        let stop = next == 1
        if stop {
            pos = steps
        }
        if stop == false {
            // Stream the decoded piece (a view into the live tokenizer mapping,
            // or the decode scratch for a raw-byte `<0xNN>` fallback token).
            let piece = decode(tk, token, next, dec_scratch)
            check world.out.write(piece)
            token = next
        }
    }
    check world.out.write("\n")

    std.fs.munmap(&mut tm)
    std.fs.munmap(&mut m)
    return
}
